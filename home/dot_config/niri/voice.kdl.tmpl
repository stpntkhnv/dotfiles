// Voice input -- managed by chezmoi, generated from voice.kdl.tmpl.
// config.kdl includes this unconditionally, so it stays a valid (if empty)
// KDL document when voice input is switched off.
{{ if has "voice" .enabled }}
// Handy is a Tauri app, and Tauri's global-shortcut plugin cannot grab keys
// on wlroots-style compositors -- they do not implement
// zwp_keyboard_shortcuts_inhibit_manager_v1. Upstream's recommended fix for
// Wayland is to let the compositor own the keybind and poke the running
// process with a Unix signal:
//
//     SIGUSR2  toggle transcription
//     SIGUSR1  toggle transcription with post-processing
//
// --start-hidden keeps the main window closed; Handy lives in the tray.
spawn-at-startup "handy" "--start-hidden"

{{- if has "voice-postprocess" .enabled }}
// The plain key gets the mode wanted by default, so muscle memory does not
// depend on which features are ticked; raw transcription stays one modifier
// away as the road back. SIGUSR1 is transcribe-with-post-processing, SIGUSR2
// is transcription alone.
binds {
    Mod+Shift+D hotkey-overlay-title="Voice Input: Dictate (cleaned up)" {
        spawn "pkill" "-USR1" "-x" "handy";
    }
    Mod+Ctrl+D hotkey-overlay-title="Voice Input: Dictate (raw)" {
        spawn "pkill" "-USR2" "-x" "handy";
    }
}
{{- else }}
binds {
    Mod+Shift+D hotkey-overlay-title="Voice Input: Toggle Dictation" {
        spawn "pkill" "-USR2" "-x" "handy";
    }
}
{{- end }}
{{ else }}
// Voice input is disabled (the `voice` feature is not selected).
{{ end }}
