// Voice input -- managed by chezmoi, generated from voice.kdl.tmpl.
// config.kdl includes this unconditionally, so it stays a valid (if empty)
// KDL document when voice input is switched off.
{{ if has "voice" .enabled }}
// Handy is a Tauri app, and Tauri's global-shortcut plugin cannot grab keys
// on wlroots-style compositors -- they do not implement
// zwp_keyboard_shortcuts_inhibit_manager_v1. So the compositor owns the keybind
// and pokes the already-running process. Handy accepts two ways of being poked,
// Unix signals and the CLI flag below; the signals are unusable, because
// WebKit's garbage collector owns SIGUSR1 inside the same process and a
// pkill -USR1 segfaults Handy 0.9.4 in libjavascriptcoregtk before it can even
// log receiving it. The whole story is in the README, under Voice input ->
// Signals.
//
// --start-hidden keeps the main window closed; Handy lives in the tray.
spawn-at-startup "handy" "--start-hidden"

binds {
    Mod+Shift+D hotkey-overlay-title="Voice Input: Toggle Dictation" {
        spawn "handy" "--toggle-transcription";
    }
}
{{ else }}
// Voice input is disabled (the `voice` feature is not selected).
{{ end }}
