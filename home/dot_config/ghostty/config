# Managed by chezmoi.

# Every window is its own OS process. This is the reason ghostty was picked
# over daemon-style terminals: five windows with five busy agents cannot slow
# each other down, and a crash takes out one window, not all of them.
# Without this, launching via the .desktop file would reuse one GTK process.
gtk-single-instance = false

# Colors come from DankMaterialShell: matugen renders themes/dankcolors on
# every theme change (matugenTemplateGhostty in DMS settings). chezmoi only
# ships an empty placeholder (create_) so a clean machine starts without a
# missing-theme error; DMS overwrites it and chezmoi never touches it again.
theme = dankcolors

font-family = JetBrainsMono Nerd Font
font-size = 13

# Starting geometry in cells, for windows the compositor lets float; in a
# niri column the tile wins anyway, so this only sets the floating default.
window-width = 120
window-height = 34

# niri draws its own borders; a GTK titlebar in a tiling session is dead weight.
window-decoration = none
window-padding-x = 8
window-padding-y = 8

# tmux runs inside and survives the window: closing costs nothing worth a
# confirmation dialog.
confirm-close-surface = false

# Selecting is copying; the X11 reflex, but into the real clipboard.
copy-on-select = clipboard

# New windows open where the current one is working (shell integration).
window-inherit-working-directory = true

mouse-hide-while-typing = true

# Matugen palettes are generated, not hand-tuned: guarantee text never lands
# on a background it blends into.
minimum-contrast = 1.1

# Newline instead of submit in agent CLIs (Claude Code and friends).
keybind = shift+enter=text:\n
