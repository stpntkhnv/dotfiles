# Umbrella over every host browser: systemd's dash notation makes
# browser-firefox.slice and browser-chromium.slice children of this one,
# so the numbers below are the TOTAL budget no matter how many browsers
# are open. Children still carry their own caps, but can never push the
# sum past this.
[Unit]
Description=Total budget for all browsers

# 2026-08-26: raised with the Zen resize (see browser-zen.slice) -- the
# umbrella must sit above the largest child or the parent cap binds first,
# which is exactly what the retired 99-local.conf drop-ins existed to fix.
# Still below the children's sum on purpose: the shared cap binds when
# several browsers are open at once.
[Slice]
MemoryHigh=10G
MemoryMax=12G
