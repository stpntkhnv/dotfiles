{{/*
   What NOT to deploy. Conditions are about features rather than environments:
   the VS Code config shows up wherever VS Code was picked, not wherever "we
   are in a container". The old host/container split was exactly what stopped
   one program from reaching both environments.

   Two entries at the bottom carry an environment test on top of the feature
   one -- `work` and `ssh-restore`. Each is a command that would break or
   need its own setup inside a container; each block says why in its own
   comment.

   Scripts no longer appear here: they live in .chezmoiscripts/, are not
   targets, and disable themselves in-template (`exit 0` at the top). The
   separate rule about stripping run_/onchange_/before_ prefixes is gone with
   them.
*/}}

{{ if not (has "neovim" .enabled) }}
.config/nvim/**
{{ end }}

{{ if not (has "vscode" .enabled) }}
.config/Code/**
.config/code-flags.conf
{{ end }}

{{ if not (has "node" .enabled) }}
.npmrc
{{ end }}

{{ if not (has "tmux" .enabled) }}
.tmux.conf
{{ end }}

{{ if not (has "desktop" .enabled) }}
.config/niri/**
.config/DankMaterialShell/**
{{ end }}

{{ if not (has "distrobox" .enabled) }}
.config/distrobox/**
{{ end }}

{{ if not (has "wallpapers" .enabled) }}
Pictures/**
{{ end }}

{{ if not (has "firefox" .enabled) }}
.config/systemd/user/browser-firefox.slice
.local/share/applications/firefox.desktop
{{ end }}

{{ if not (has "chromium" .enabled) }}
.config/systemd/user/browser-chromium.slice
.local/share/applications/chromium.desktop
{{ end }}

{{ if not (has "zen" .enabled) }}
.config/systemd/user/browser-zen.slice
.local/share/applications/zen.desktop
{{ end }}

{{/* The umbrella and the launcher helper belong to whichever browsers exist,
     so they only go away when none of them do. */}}
{{ if and (not (has "firefox" .enabled)) (not (has "chromium" .enabled)) (not (has "zen" .enabled)) }}
.config/systemd/user/browser.slice
.local/bin/slice-run
{{ end }}

{{ if not (has "ziti" .enabled) }}
bin/update-ziti-hosts.sh
{{ end }}

{{/* The one command that is host-only for a reason: it drives a herdr server
     that runs here and enters containers from the outside. `herdr` itself is
     scope: both, so gating on the feature alone would ship `work` into every
     container, where `distrobox enter` does not exist and it would break on
     the first run. */}}
{{ if or (not (has "herdr" .enabled)) (ne .env "host") }}
.local/bin/work
{{ end }}

{{/* Host-only like `work` above, and for the same shape of reason: the
     restore talks to keepassxc-cli and the vault file, both of which live on
     the host; inside a container it would die on the first call. The script
     additionally refuses at runtime when it sees /run/host. */}}
{{ if or (not (has "keepassxc" .enabled)) (ne .env "host") }}
.local/bin/ssh-restore
{{ end }}
