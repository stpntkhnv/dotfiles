# Shadows /usr/share/applications/zen.desktop (same filename wins in
# ~/.local). Two deliberate differences from upstream:
#   * the browser starts inside browser-zen.slice, so its memory is capped;
#   * MimeType carries NO x-scheme-handler/http(s). A bare "Zen Browser" entry
#     in the link picker would open the URL in whatever container the current
#     workspace happens to use, which is the exact silent mis-landing this
#     setup exists to prevent. The per-context entries offered by the picker
#     are generated by .chezmoiscripts/run_onchange_after_38-linkrouting.sh.
[Desktop Entry]
Type=Application
Name=Zen Browser
GenericName=Web Browser
Icon=zen-browser
Exec=systemd-run --user --scope --slice=browser-zen.slice --collect -q /usr/bin/zen-browser %u
Terminal=false
StartupNotify=true
StartupWMClass=zen
Categories=Network;WebBrowser;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=systemd-run --user --scope --slice=browser-zen.slice --collect -q /usr/bin/zen-browser --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=systemd-run --user --scope --slice=browser-zen.slice --collect -q /usr/bin/zen-browser --private-window %u
