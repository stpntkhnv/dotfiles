#!/bin/bash
{{- if ne .env "container" }}
exit 0
{{- else }}
set -euo pipefail

# microsocks listens on this container's loopback; socat republishes it on a
# UNIX socket in /var/lib/wsproxy, the one directory shared with the host. The
# host browser dials that socket, so every request it sends for this work
# context leaves through THIS container's netns, resolver and VPN.
#
# Not /mnt: distrobox-init bind-mounts the host's /mnt over the container's at
# every start, hiding a podman volume placed there. See distrobox.ini.tmpl.
#
# Both units run as the user rather than root. distrobox creates containers
# with --userns keep-id, which maps container uid 1000 to host uid 1000 but
# container root to a subuid: a root-owned socket would be unreachable from
# the host browser.
#
# System units rather than user units because the container runs systemd as
# init (init=true in distrobox.ini) and there is no logind session inside.
#
# A before-script, and an early one (15, right after bootstrap-pacman), on
# purpose: the rest of the setup regularly needs the host browser open in THIS
# context's space — logins, tokens, claudefiles prompts — and that space has
# no network until this bridge is live. It used to run as after-36, which
# meant no browser until the whole package install had finished.

if [[ ! -d /var/lib/wsproxy ]]; then
    echo "!! /var/lib/wsproxy is not mounted: this container predates the volume."
    echo "!! Recreate it: distrobox rm $(. /run/.containerenv; echo "$name") &&"
    echo "!!   distrobox assemble create --name ... --file ~/.config/distrobox/distrobox.ini"
    exit 0
fi

# socat and microsocks are also in container-base, but that installs at step
# 20 — too late for a bridge that wants to be up at 15. On a fresh container
# the sync (-Sy) is required: bootstrap-10 only fixed the mirrorlist, no db
# has been fetched yet. On later runs the command guard skips pacman entirely,
# so no partial-upgrade risk builds up here; step 20 still runs the full -Syu.
if ! command -v microsocks &>/dev/null || ! command -v socat &>/dev/null; then
    echo "==> Installing socat and microsocks for the bridge..."
    sudo pacman -Sy --noconfirm --needed socat microsocks
fi

# OAuth callbacks from CLI tools (claude, codex) land on http://localhost:<port>
# inside this netns. The browser hands the *name* localhost to microsocks
# (proxyDNS in context-proxy), glibc resolves it ::1-first per RFC 6724, and
# microsocks tries only the first address with no fallback — while the CLIs
# listen on 127.0.0.1 only. Connection refused, login never completes. gai.conf
# flips the ordering to IPv4-first for the whole container; its only egress is
# an IPv4 SOCKS proxy anyway, so nothing is lost.
echo "==> Preferring IPv4 in getaddrinfo (gai.conf)..."
printf 'precedence ::ffff:0:0/96 100\n' | sudo tee /etc/gai.conf >/dev/null

echo "==> Installing the browser proxy units..."

sudo tee /etc/systemd/system/wsproxy-socks.service >/dev/null <<'UNIT'
[Unit]
Description=SOCKS5 server for the host browser
After=network.target

[Service]
User={{ .chezmoi.username }}
ExecStart=/usr/bin/microsocks -i 127.0.0.1 -p 1080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

sudo tee /etc/systemd/system/wsproxy-bridge.service >/dev/null <<'UNIT'
[Unit]
Description=UNIX-socket bridge to the host browser
Requires=wsproxy-socks.service
After=wsproxy-socks.service

[Service]
User={{ .chezmoi.username }}
ExecStart=/usr/bin/socat UNIX-LISTEN:/var/lib/wsproxy/socks.sock,fork,mode=600,unlink-early TCP:127.0.0.1:1080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

sudo systemctl daemon-reload
sudo systemctl enable --now wsproxy-socks.service wsproxy-bridge.service
{{- end }}
