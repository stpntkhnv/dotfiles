#!/bin/bash
{{- if ne .env "container" }}
exit 0
{{- else }}
set -euo pipefail

# Everything clicked inside this container that is a web link goes to the host
# browser AND lands in the matching Zen container, no matter which workspace is
# focused.
#
# /usr/local/bin comes before /usr/bin on PATH, so this shadows xdg-utils.
# Non-web arguments fall through to the real xdg-open: with init=true distrobox
# does NOT replace xdg-open (see distrobox-init, the symlink is guarded by
# `init -eq 0`), so a PDF still opens in this container's own viewer, which is
# the behaviour that was there before.
#
# The link leaves through the UNIX socket in /var/lib/wsproxy -- this context's
# own directory on the host, the same mount the SOCKS proxy uses, and the only
# channel out of here. The host end is zenopen-<context>.service, written by
# 38-linkrouting.
#
# What is deliberately NOT here any more: the container's name. It used to be
# read from /run/.containerenv and passed to the host as an argument, which made
# the container the authority on which context it belongs to. Now the host reads
# it off the socket the line arrived on. The old route also used
# distrobox-host-exec, which on this machine returned 127 for every command with
# no output whatsoever -- see 38-linkrouting for why.

echo "==> Installing the container link wrapper..."

sudo tee /usr/local/bin/xdg-open >/dev/null <<'WRAP'
#!/bin/sh
# Managed by chezmoi -- .chezmoiscripts/run_onchange_after_37-container-links.sh
case "${1:-}" in
    http://*|https://*) ;;
    *) exec /usr/bin/xdg-open "$@" ;;
esac

SOCK=/var/lib/wsproxy/links.sock

# No socket means the host is not listening for this context: Zen is not
# installed there, or zenopen-<context>.service is down.
#
# This does NOT fall through to /usr/bin/xdg-open, and that is deliberate.
# This repo installs no browser inside containers (`firefox`, `chromium` and
# `zen` are all scope: host), but claudefiles may have put chromium here for
# Playwright MCP -- and falling through would then open the link in the
# container's own chromium, the exact silent mis-landing this wrapper exists
# to prevent. Without a browser the fallback fails badly anyway: sixteen
# lines of "command not found" that read like noise. One line naming the
# actual missing piece is worth more.
if [ ! -S "$SOCK" ]; then
    echo "xdg-open: no link socket at $SOCK -- is zenopen-<context>.service running on the host?" >&2
    exit 1
fi

# socat is in container-base with always: true, so this should never fire. It is
# here because without it a missing socat looks exactly like a host that did not
# answer, and that message would send the reader to the wrong machine.
if ! command -v socat >/dev/null 2>&1; then
    echo "xdg-open: socat is missing in this container, cannot reach the host" >&2
    exit 1
fi

reply=$(printf '%s\n' "$1" | socat -T5 - "UNIX-CONNECT:$SOCK" 2>/dev/null || true)
case "$reply" in
    ok) ;;
    '') echo "xdg-open: the host did not answer on $SOCK" >&2; exit 1 ;;
    *)  echo "xdg-open: the host refused the link ($reply)" >&2; exit 1 ;;
esac
WRAP

sudo chmod 755 /usr/local/bin/xdg-open

# The wrapper only catches callers that resolve `xdg-open` through PATH.
# Anything that opens links through GLib (gio open, GAppInfo — plenty of CLIs
# do) never looks at PATH: it takes the default handler from mimeapps.list,
# and with no default it falls back to whatever installed .desktop file
# claims the scheme. This repo installs no browser inside containers, but
# other tooling legitimately can — claudefiles puts chromium here as the
# Playwright MCP browser — and then a login link from a CLI silently opens
# the container's own chromium instead of routing to Zen on the host.
# So the wrapper gets a .desktop entry of its own and is pinned as the
# default http(s) handler for this container's user.
sudo install -d /usr/local/share/applications
sudo tee /usr/local/share/applications/container-link.desktop >/dev/null <<'DESK'
[Desktop Entry]
Type=Application
Name=Zen on host (context route)
Exec=/usr/local/bin/xdg-open %u
MimeType=x-scheme-handler/http;x-scheme-handler/https;
NoDisplay=true
Terminal=false
DESK

if command -v update-desktop-database >/dev/null 2>&1; then
    sudo update-desktop-database /usr/local/share/applications 2>/dev/null || true
fi

if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default container-link.desktop x-scheme-handler/http x-scheme-handler/https \
        || echo "!! could not set container-link.desktop as the default link handler" >&2
else
    echo "!! xdg-mime not found, default link handler left as is" >&2
fi
{{- end }}
