#!/bin/bash
set -euo pipefail
{{- if or (has "browsers" .enabled) (has "zen" .enabled) }}

# Extensions arrive through system policies: the browser installs them on next
# start, no store visit needed. Every file below is wholly owned by this
# script; anything else that ever needs a browser policy belongs here too.
#
# The system policy directory is /etc/<MOZ_APP_NAME>/policies, derived from the
# app name -- NOT a literal /etc/firefox that every fork honours. Zen builds
# with MOZ_APP_NAME=zen (see RemotingName in /opt/zen-browser-bin/
# application.ini), so it reads /etc/zen/policies/policies.json and ignores the
# Firefox one entirely. Getting this wrong is silent: the browser starts fine,
# reports no error, and simply has no extensions.
#
# That directory WINS over <appdir>/distribution/policies.json, so writing it
# discards what the package shipped. DisableAppUpdate and
# DefaultSerialGuardSetting are carried over from there: without the first, a
# pacman-installed browser starts updating itself behind pacman's back.
#
# The two browsers get different extension sets. Zen is the one carrying work
# contexts, so it gets the container stack; Firefox is the everything-else
# browser and only wants the password manager.
#
# installation_mode is not uniform, and the split is the point:
#   force_installed  -- Multi-Account Containers and Open external links. These
#                       are not preferences, they ARE the container boundary.
#                       Removing one silently collapses every work context into
#                       one cookie jar, and nothing in the UI would say so.
#   normal_installed -- Temporary Containers and Bitwarden: enabled on arrival,
#                       still removable. Personal machine, not a fleet.
#
# GUIDs come from the AMO API (addons.mozilla.org/api/v5/addons/addon/<slug>/),
# not from guessing: a wrong key installs nothing and says nothing.
{{- $bitwarden := dict "guid" "{446900e4-71c2-419f-a6a7-df9c091e268b}" "slug" "bitwarden-password-manager" "mode" "normal_installed" }}
{{- $zenExts := list }}
{{- if has "zen" .enabled }}
{{-   $zenExts = append $zenExts (dict "guid" "@testpilot-containers"                  "slug" "multi-account-containers" "mode" "force_installed") }}
{{-   $zenExts = append $zenExts (dict "guid" "{f069aec0-43c5-4bbf-b6b4-df95c4326b98}" "slug" "open-url-in-container"    "mode" "force_installed") }}
{{-   $zenExts = append $zenExts (dict "guid" "{c607c8df-14a7-4f28-894f-29e8722976af}" "slug" "temporary-containers"     "mode" "normal_installed") }}
{{-   if has "bitwarden" .enabled }}{{ $zenExts = append $zenExts $bitwarden }}{{ end }}
{{-   $zenExts = append $zenExts (dict "guid" "context-proxy@dotfiles.local" "url" "file:///usr/local/lib/zen-context-proxy.xpi" "mode" "force_installed") }}
{{- end }}
{{/* Containers.Default replaces the built-in set on a FRESH profile and
     numbers them 1..N in array order (ContextualIdentityService.sys.mjs:226).
     On a profile that already has containers.json it does nothing, so this
     seeds a new machine and never disturbs a working one. Scratch last, and
     without a proxy: it is the "no work session attached" one. */}}
{{- $containers := list }}
{{- if has "zen" .enabled }}
{{-   range $i, $c := .contexts }}
{{-     $containers = append $containers (dict "name" $c.name "icon" "briefcase" "color" (index (list "blue" "green" "purple" "orange" "red" "yellow" "pink" "cyan") (mod $i 8))) }}
{{-   end }}
{{-   $containers = append $containers (dict "name" "scratch" "icon" "circle" "color" "gray") }}
{{- end }}
{{- $ffExts := list }}
{{- if and (has "browsers" .enabled) (has "bitwarden" .enabled) }}
{{-   $ffExts = append $ffExts $bitwarden }}
{{- end }}

# $1 is the /etc directory of one Gecko application, $2 the already-rendered
# body of ExtensionSettings (empty for none), $3 the body of Containers.Default
# (empty for none).
write_gecko_policy() {
    local dir="$1" exts="$2" containers="${3:-}" settings="" contblock=""
    [[ -n "$exts" ]] && settings=$(printf ',\n    "ExtensionSettings": {\n%s\n    }' "$exts")
    [[ -n "$containers" ]] && contblock=$(printf ',\n    "Containers": {\n      "Default": [\n%s\n      ]\n    }' "$containers")
    sudo install -d "$dir/policies"
    sudo tee "$dir/policies/policies.json" >/dev/null <<EOF
{
  "policies": {
    "DisableAppUpdate": true,
    "DefaultSerialGuardSetting": 3$settings$contblock
  }
}
EOF
    echo "==> Policy written: $dir/policies/policies.json"
}

echo "==> Installing browser extension policies..."
{{- if and (has "browsers" .enabled) (has "bitwarden" .enabled) }}

sudo install -d /etc/chromium/policies/managed
sudo tee /etc/chromium/policies/managed/bitwarden-extension.json >/dev/null <<'EOF'
{
  "ExtensionSettings": {
    "nngceckbapebfimnlniiiahkandclblb": {
      "installation_mode": "normal_installed",
      "update_url": "https://clients2.google.com/service/update2/crx"
    }
  }
}
EOF
{{- end }}
{{- range $app := list (dict "dir" "/etc/firefox" "exts" $ffExts "containers" list "on" (has "browsers" .enabled)) (dict "dir" "/etc/zen" "exts" $zenExts "containers" $containers "on" (has "zen" .enabled)) }}
{{- if $app.on }}

write_gecko_policy {{ $app.dir }} '{{ range $i, $e := $app.exts }}{{ if $i }},
{{ end }}      "{{ $e.guid }}": {
        "installation_mode": "{{ $e.mode }}",
        "install_url": "{{ if hasKey $e "url" }}{{ $e.url }}{{ else }}https://addons.mozilla.org/firefox/downloads/latest/{{ $e.slug }}/latest.xpi{{ end }}"
      }{{ end }}' '{{ range $i, $c := $app.containers }}{{ if $i }},
{{ end }}        { "name": "{{ $c.name }}", "icon": "{{ $c.icon }}", "color": "{{ $c.color }}" }{{ end }}'
{{- end }}
{{- end }}
{{- end }}
