#!/bin/bash
set -euo pipefail
{{- if or (has "browsers" .enabled) (has "zen" .enabled) }}

# Extensions arrive through system policies: the browser installs them on next
# start, no store visit needed. Both files are wholly owned by this script;
# anything else that ever needs a browser policy belongs here too.
#
# /etc/firefox/policies is read by Firefox forks as well, Zen included: the
# path is a literal in the Mozilla source, not derived from the app name.
# Verify after the first launch with about:policies -> Active.
#
# That path also WINS over the app directory, so writing it discards whatever
# the package shipped in /opt/zen-browser-bin/distribution/policies.json.
# DisableAppUpdate and DefaultSerialGuardSetting are carried over from there:
# without the first, a pacman-installed browser starts updating itself behind
# pacman's back. Both are correct for Firefox too, which is equally
# pacman-managed here.
#
# installation_mode is not uniform, and the split is the point:
#   force_installed  -- Multi-Account Containers and Open external links. These
#                       are not preferences, they ARE the container boundary.
#                       Removing one silently collapses every work context into
#                       one cookie jar, and nothing in the UI would say so.
#   normal_installed -- Temporary Containers and Bitwarden: enabled on arrival,
#                       still removable. Personal machine, not a fleet.
#
# GUIDs come from the AMO API (addons.mozilla.org/api/v5/addons/addon/<slug>/),
# not from guessing: a wrong key installs nothing and says nothing.
{{- $exts := list }}
{{- if has "zen" .enabled }}
{{-   $exts = append $exts (dict "guid" "@testpilot-containers"                  "slug" "multi-account-containers" "mode" "force_installed") }}
{{-   $exts = append $exts (dict "guid" "{f069aec0-43c5-4bbf-b6b4-df95c4326b98}" "slug" "open-url-in-container"    "mode" "force_installed") }}
{{-   $exts = append $exts (dict "guid" "{c607c8df-14a7-4f28-894f-29e8722976af}" "slug" "temporary-containers"     "mode" "normal_installed") }}
{{- end }}
{{- if has "bitwarden" .enabled }}
{{-   $exts = append $exts (dict "guid" "{446900e4-71c2-419f-a6a7-df9c091e268b}" "slug" "bitwarden-password-manager" "mode" "normal_installed") }}
{{- end }}

echo "==> Installing browser extension policies..."
{{- if and (has "browsers" .enabled) (has "bitwarden" .enabled) }}

sudo install -d /etc/chromium/policies/managed
sudo tee /etc/chromium/policies/managed/bitwarden-extension.json >/dev/null <<'EOF'
{
  "ExtensionSettings": {
    "nngceckbapebfimnlniiiahkandclblb": {
      "installation_mode": "normal_installed",
      "update_url": "https://clients2.google.com/service/update2/crx"
    }
  }
}
EOF
{{- end }}

sudo install -d /etc/firefox/policies
sudo tee /etc/firefox/policies/policies.json >/dev/null <<'EOF'
{
  "policies": {
    "DisableAppUpdate": true,
    "DefaultSerialGuardSetting": 3{{ if $exts }},
    "ExtensionSettings": {
{{- range $i, $e := $exts }}
      {{ if $i }},{{ end }}"{{ $e.guid }}": {
        "installation_mode": "{{ $e.mode }}",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/{{ $e.slug }}/latest.xpi"
      }
{{- end }}
    }{{ end }}
  }
}
EOF
{{- end }}
