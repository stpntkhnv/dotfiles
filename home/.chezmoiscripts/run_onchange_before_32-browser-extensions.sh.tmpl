#!/bin/bash
set -euo pipefail
{{- if or (has "browsers" .enabled) (has "zen" .enabled) }}

# Extensions arrive through system policies: the browser installs them on next
# start, no store visit needed. Every file below is wholly owned by this
# script; anything else that ever needs a browser policy belongs here too.
#
# The system policy directory is /etc/<MOZ_APP_NAME>/policies, derived from the
# app name -- NOT a literal /etc/firefox that every fork honours. Zen builds
# with MOZ_APP_NAME=zen (see RemotingName in /opt/zen-browser-bin/
# application.ini), so it reads /etc/zen/policies/policies.json and ignores the
# Firefox one entirely. Getting this wrong is silent: the browser starts fine,
# reports no error, and simply has no extensions.
#
# That directory WINS over <appdir>/distribution/policies.json, so writing it
# discards what the package shipped. DisableAppUpdate and
# DefaultSerialGuardSetting are carried over from there: without the first, a
# pacman-installed browser starts updating itself behind pacman's back.
#
# The two browsers get different extension sets. Zen is the one carrying work
# contexts, so it gets the container stack; Firefox is the everything-else
# browser and only wants the password manager.
#
# installation_mode is not uniform, and the split is the point:
#   force_installed  -- Multi-Account Containers and Open external links. These
#                       are not preferences, they ARE the container boundary.
#                       Removing one silently collapses every work context into
#                       one cookie jar, and nothing in the UI would say so.
#   normal_installed -- Temporary Containers and Bitwarden: enabled on arrival,
#                       still removable. Personal machine, not a fleet.
#
# GUIDs come from the AMO API (addons.mozilla.org/api/v5/addons/addon/<slug>/),
# not from guessing: a wrong key installs nothing and says nothing.
{{- $bitwarden := dict "guid" "{446900e4-71c2-419f-a6a7-df9c091e268b}" "slug" "bitwarden-password-manager" "mode" "normal_installed" }}
{{/* Zen refuses our own extension without this, and the refusal is silent
     unless the browser console is open: "Download failed -
     ERROR_SIGNEDSTATE_REQUIRED - file:///usr/local/lib/zen-context-proxy.xpi".
     MOZ_REQUIRE_SIGNING is false in this build, but that only makes the pref
     settable rather than constant (AddonSettings.sys.mjs:32-48) -- and the
     application default flips it back on:
     browser/omni.ja defaults/preferences/firefox.js:27 says true, overriding
     the false in toolkit's greprefs.js. So the extension has never once been
     installed on this machine; measured on a throwaway profile, and measured
     again with this pref in place, where it installs.

     Through the policy rather than user.js because the policy is read before a
     profile exists, so the extension arrives on the FIRST launch of Zen.
     Locked so about:config cannot drift it and a Zen update cannot win. The
     pref is only in the policy allowlist because MOZ_REQUIRE_SIGNING is off
     (Policies.sys.mjs:2464-2466); a build that turns the flag on makes this
     unsettable, and run_after_zz-next-steps.sh is what would notice.

     Firefox gets none of this: it carries one extension, from AMO, signed. */}}
{{- $zenPrefs := "" }}
{{- if has "zen" .enabled }}
{{-   $zenPrefs = `      "xpinstall.signatures.required": { "Value": false, "Status": "locked" }` }}
{{- end }}
{{- $zenExts := list }}
{{- if has "zen" .enabled }}
{{-   $zenExts = append $zenExts (dict "guid" "@testpilot-containers"                  "slug" "multi-account-containers" "mode" "force_installed") }}
{{-   $zenExts = append $zenExts (dict "guid" "{f069aec0-43c5-4bbf-b6b4-df95c4326b98}" "slug" "open-url-in-container"    "mode" "force_installed") }}
{{-   $zenExts = append $zenExts (dict "guid" "{c607c8df-14a7-4f28-894f-29e8722976af}" "slug" "temporary-containers"     "mode" "normal_installed") }}
{{-   if has "bitwarden" .enabled }}{{ $zenExts = append $zenExts $bitwarden }}{{ end }}
{{-   $zenExts = append $zenExts (dict "guid" "context-proxy@dotfiles.local" "url" "file:///usr/local/lib/zen-context-proxy.xpi" "mode" "force_installed") }}
{{- end }}
{{/* Containers.Default replaces the built-in set on a FRESH profile and
     numbers them 1..N in array order (ContextualIdentityService.sys.mjs:226).
     On a profile that already has containers.json it does nothing, so this
     seeds a new machine and never disturbs a working one. plain_context last,
     and without a proxy: it is the "no work session attached" one.

     Its colour is deliberately outside the rotation below, so it stays telling
     apart from work no matter how many contexts get added. */}}
{{- $containers := list }}
{{- $palette := list "blue" "green" "purple" "orange" "red" "yellow" "pink" }}
{{- if has "zen" .enabled }}
{{-   range $i, $c := .contexts }}
{{-     $containers = append $containers (dict "name" $c.name "icon" "briefcase" "color" (index $palette (mod $i (len $palette)))) }}
{{-   end }}
{{-   $containers = append $containers (dict "name" $.plain_context.name "icon" $.plain_context.icon "color" $.plain_context.color) }}
{{- end }}
{{/* One toolbar folder per context, holding the shared bookmarks plus that
     context's own, each as an ext+container: link. The container travels in
     the link, so a bookmark clicked from the wrong space still lands right --
     which is the whole point, and the reason these are not plain URLs.

     What the policy engine does with them is narrower than it looks. It matches
     BY URL and builds two lists, add and remove; there is no update step at all
     (BookmarksPolicies.sys.mjs:101-185). So renaming one or dragging it into
     another folder survives, deleting one brings it back on the next start, and
     dropping a line from the table above is what actually removes it. Bookmarks
     of your own are never touched: ours carry the guid prefix PolB-, our folders
     PolF-.

     bookmarks_demo is a flat folder of plain URLs whose titles say what to try;
     it exists to make the difference from ManagedBookmarks visible by hand.

     plain_context gets a folder of the same shape, but only from its own list:
     the shared bookmarks are work addresses and have no business there. */}}
{{- $marks := list }}
{{- if has "zen" .enabled }}
{{-   range $c := .contexts }}
{{-     $own := list }}
{{-     if hasKey $c "bookmarks" }}{{ $own = $c.bookmarks }}{{ end }}
{{-     range $b := concat $.bookmarks $own }}
{{-       $marks = append $marks (dict "title" $b.title "folder" $c.name "url" (printf "ext+container:name=%s&url=%s" $c.name (urlquery $b.url))) }}
{{-     end }}
{{-   end }}
{{-   if hasKey .plain_context "bookmarks" }}
{{-     range $b := .plain_context.bookmarks }}
{{-       $marks = append $marks (dict "title" $b.title "folder" $.plain_context.name "url" (printf "ext+container:name=%s&url=%s" $.plain_context.name (urlquery $b.url))) }}
{{-     end }}
{{-   end }}
{{- end }}
{{- if and (has "zen" .enabled) (hasKey . "bookmarks_demo") }}
{{-   range $b := .bookmarks_demo.items }}
{{-     $marks = append $marks (dict "title" $b.title "folder" $.bookmarks_demo.folder "url" $b.url) }}
{{-   end }}
{{- end }}
{{- $ffExts := list }}
{{- if and (has "browsers" .enabled) (has "bitwarden" .enabled) }}
{{-   $ffExts = append $ffExts $bitwarden }}
{{- end }}

# $1 is the /etc directory of one Gecko application, $2 the already-rendered
# body of ExtensionSettings, $3 of Containers.Default, $4 of Bookmarks, $5 the
# whole ManagedBookmarks array, $6 the body of Preferences. Empty for none.
write_gecko_policy() {
    local dir="$1" exts="$2" containers="${3:-}" marks="${4:-}"
    local managed="${5:-}" prefs="${6:-}"
    local settings="" contblock="" markblock="" managedblock="" prefblock="" toolbar=""
    [[ -n "$exts" ]] && settings=$(printf ',\n    "ExtensionSettings": {\n%s\n    }' "$exts")
    [[ -n "$containers" ]] && contblock=$(printf ',\n    "Containers": {\n      "Default": [\n%s\n      ]\n    }' "$containers")
    [[ -n "$marks" ]] && markblock=$(printf ',\n    "Bookmarks": [\n%s\n    ]' "$marks")
    [[ -n "$managed" ]] && managedblock=$(printf ',\n    "ManagedBookmarks": %s' "$managed")
    [[ -n "$prefs" ]] && prefblock=$(printf ',\n    "Preferences": {\n%s\n    }' "$prefs")
    # Neither kind of bookmark is visible while the toolbar is hidden, and Zen
    # hides it by default: browser/omni.ja defaults/preferences/firefox.js:1520
    # sets browser.toolbars.bookmarks.visibility to "never", overriding the
    # "newtab" that Firefox itself ships. The managed folder is worse than
    # merely inconvenient there -- it exists ONLY as a toolbar button
    # (browser-init.js:717-779 builds it and drops it into
    # CustomizableUI.AREA_BOOKMARKS, and nowhere else), so a hidden toolbar
    # means no way to reach it at all. The policy is runOncePerModification, so
    # hiding the toolbar again by hand sticks.
    if [[ -n "$marks" || -n "$managed" ]]; then
        toolbar=$(printf ',\n    "DisplayBookmarksToolbar": "always"')
    fi
    sudo install -d "$dir/policies"
    sudo tee "$dir/policies/policies.json" >/dev/null <<EOF
{
  "policies": {
    "DisableAppUpdate": true,
    "DefaultSerialGuardSetting": 3$settings$contblock$markblock$managedblock$prefblock$toolbar
  }
}
EOF
    echo "==> Policy written: $dir/policies/policies.json"
}
{{ if and (has "zen" .enabled) (hasKey . "managed_bookmarks") }}
# The tree arrives through a quoted heredoc rather than a single-quoted
# assignment: an apostrophe in a bookmark title would otherwise close the string
# and take the whole file with it -- the same trap the Syncthing labels hit.
managed_raw="$(cat <<'MANAGED_EOF'
{{ .managed_bookmarks | toJson }}
MANAGED_EOF
)"
contexts_json="$(cat <<'CONTEXTS_EOF'
{{ $ctx := list }}{{ range .contexts }}{{ $ctx = append $ctx .name }}{{ end }}{{ $ctx = append $ctx $.plain_context.name }}{{ $ctx | toJson }}
CONTEXTS_EOF
)"

# The one hard failure in this file. A context that matches nothing does not
# degrade, it lies: the proxy extension creates any container name it cannot
# find (see the comment in 41-zen-context-proxy), and a container it created has
# no proxy, so the bookmark opens in something that looks like a work container
# and leaves through the host. Better a failed apply than that.
unknown=$(jq -r --argjson ok "$contexts_json" \
    '[.. | objects | select(has("context")) | .context] - $ok | unique | join(", ")' \
    <<<"$managed_raw") || unknown="jq failed"
if [[ -n "$unknown" ]]; then
    echo "!! managed_bookmarks names a context that does not exist: $unknown" >&2
    echo "!! fix home/.chezmoidata.yaml; known contexts: $contexts_json" >&2
    exit 1
fi

# walk() rather than recursion in the template: a recursive Go template needs a
# named file in .chezmoitemplates, and jq is already here for zen-open. @uri
# encodes the whole URL, including its own '&', which is what stops the hand-off
# from being truncated.
managed=$(jq -c 'walk(
    if type=="object" and has("url") and has("context")
    then .url = "ext+container:name=" + .context + "&url=" + (.url|@uri) | del(.context)
    else . end)' <<<"$managed_raw")
{{ else }}
managed=""
{{ end }}
echo "==> Installing browser extension policies..."
{{- if and (has "browsers" .enabled) (has "bitwarden" .enabled) }}

sudo install -d /etc/chromium/policies/managed
sudo tee /etc/chromium/policies/managed/bitwarden-extension.json >/dev/null <<'EOF'
{
  "ExtensionSettings": {
    "nngceckbapebfimnlniiiahkandclblb": {
      "installation_mode": "normal_installed",
      "update_url": "https://clients2.google.com/service/update2/crx"
    }
  }
}
EOF
{{- end }}
{{- if has "browsers" .enabled }}

ff_exts="$(cat <<'FF_EXTS_EOF'
{{ range $i, $e := $ffExts }}{{ if $i }},
{{ end }}      "{{ $e.guid }}": {
        "installation_mode": "{{ $e.mode }}",
        "install_url": "https://addons.mozilla.org/firefox/downloads/latest/{{ $e.slug }}/latest.xpi"
      }{{ end }}
FF_EXTS_EOF
)"
write_gecko_policy /etc/firefox "$ff_exts" '' '' '' ''
{{- end }}
{{- if has "zen" .enabled }}

# Two explicit calls instead of one loop over both applications, because the
# arguments stopped being template values. Every block of catalogue data now
# reaches the shell through a quoted heredoc rather than a single-quoted
# argument: an apostrophe in a bookmark title would otherwise close the argument
# and take the rest of the script with it, which is the trap the Syncthing folder
# labels already hit. A template `range` cannot carry a shell variable.
zen_exts="$(cat <<'ZEN_EXTS_EOF'
{{ range $i, $e := $zenExts }}{{ if $i }},
{{ end }}      "{{ $e.guid }}": {
        "installation_mode": "{{ $e.mode }}",
        "install_url": "{{ if hasKey $e "url" }}{{ $e.url }}{{ else }}https://addons.mozilla.org/firefox/downloads/latest/{{ $e.slug }}/latest.xpi{{ end }}"
      }{{ end }}
ZEN_EXTS_EOF
)"
zen_containers="$(cat <<'ZEN_CONT_EOF'
{{ range $i, $c := $containers }}{{ if $i }},
{{ end }}        { "name": "{{ $c.name }}", "icon": "{{ $c.icon }}", "color": "{{ $c.color }}" }{{ end }}
ZEN_CONT_EOF
)"
zen_marks="$(cat <<'ZEN_MARKS_EOF'
{{ range $i, $b := $marks }}{{ if $i }},
{{ end }}      { "Title": {{ $b.title | toJson }}, "URL": {{ $b.url | toJson }}, "Folder": {{ $b.folder | toJson }}, "Placement": "toolbar" }{{ end }}
ZEN_MARKS_EOF
)"
zen_prefs="$(cat <<'ZEN_PREFS_EOF'
{{ $zenPrefs }}
ZEN_PREFS_EOF
)"
write_gecko_policy /etc/zen "$zen_exts" "$zen_containers" "$zen_marks" "$managed" "$zen_prefs"
{{- end }}
{{- end }}
