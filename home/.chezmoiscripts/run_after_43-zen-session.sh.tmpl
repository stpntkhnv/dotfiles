#!/bin/bash
{{- if or (ne .env "host") (not (has "zen" .enabled)) }}
exit 0
{{- else }}
set -euo pipefail

# Seeds a Zen space per work context, each bound to its container, and the
# Essentials inside it, so a fresh machine needs no clicking. run_after_ rather
# than run_onchange_: what it does depends on the state of the profile, not on
# the state of this file, and it has to re-evaluate that on every apply.
#
# Every profile goes through two stages, and a refusal ends its own stage while
# the run carries on, so every line says which stage it came from.
#
# Stage 1, the seeding, appends and never replaces. It used to write only into a
# profile with no tabs at all, which sounded careful and was in fact dead code:
# measured on 2026-07-30, the first launch of Zen -- the very step that creates
# the containers this stage needs -- leaves four tabs and a default space behind,
# so the guard fired on every real machine and the seeding had never run once.
# Appending removes the reason for the guard, and what is left is the honest
# check: a context whose space already exists is skipped by name.
# A running Zen is the single refusal that still ends the whole script: it
# rewrites these files from memory when it exits, so nothing written now would
# survive.
#
# Stage 2, the routing, writes zen-space-routing.jsonlz4, which is not ours
# alone: rules made by hand and defaultRouteExternal are merged, never replaced.
# Our rules carry a deterministic id so a second apply updates them in place
# rather than appending a copy -- Zen takes the FIRST match in array order, so a
# duplicate on one reference is a silent change of behaviour, not litter.
#
# containerTabId is a userContextId read from containers.json rather than
# predicted. The Containers policy does number them 1..N in array order, but
# reading beats predicting when a profile can also be older than the policy.
#
# Essentials carry a PLAIN url, unlike the bookmarks the policy generates,
# which carry ext+container:. The difference is not an oversight: a pinned tab
# already sits in a space bound to a container and states its userContextId
# outright, while a bookmark can be clicked from anywhere and has to carry its
# container in the link.

python3 - <<'PY'
import json, os, glob, subprocess, uuid, sys

HOME = os.path.expanduser("~")
# [{"name": ..., "bookmarks": [{"title": ..., "url": ...}]}]
# plain_context comes last and its Essentials carry only its own list, by
# explicit decision: one YouTube tile in home, nothing else. The shared list
# (mail, calendar) still reaches home -- as bookmarks in its toolbar folder,
# script 32 -- just not as tiles.
SEED = json.loads(r'''{{ $seed := list }}{{ range $c := .contexts }}{{ $own := list }}{{ if hasKey $c "bookmarks" }}{{ $own = $c.bookmarks }}{{ end }}{{ $seed = append $seed (dict "name" $c.name "bookmarks" (concat $.bookmarks $own)) }}{{ end }}{{ $pown := list }}{{ if hasKey .plain_context "bookmarks" }}{{ $pown = .plain_context.bookmarks }}{{ end }}{{ $seed = append $seed (dict "name" $.plain_context.name "bookmarks" $pown) }}{{ $seed | toJson }}''')
CONTEXTS = [c["name"] for c in SEED]
# The contexts carrying `route: true`. The VALUE is tested, not the presence of
# the key: `route: false` has to mean off rather than on.
ROUTED = json.loads(r'''{{ $r := list }}{{ range $c := .contexts }}{{ if and (hasKey $c "route") $c.route }}{{ $r = append $r $c.name }}{{ end }}{{ end }}{{ $r | toJson }}''')
ROUTE_FILE = "zen-space-routing.jsonlz4"
ROUTE_NS = "dotfiles:zen-space-routing:"


def mozlz4_compress(data):
    # Literals-only LZ4 block: valid by spec, since the final sequence must be
    # literals with no match and one run covering the input is exactly that.
    # Zen reads it back through the standard decoder.
    out = bytearray()
    n = len(data)
    out.append((15 if n >= 15 else n) << 4)
    if n >= 15:
        rem = n - 15
        while rem >= 255:
            out.append(255)
            rem -= 255
        out.append(rem)
    out += data
    return b"mozLz40\0" + n.to_bytes(4, "little") + bytes(out)


def mozlz4_decompress(raw):
    if raw[:8] != b"mozLz40\0":
        raise ValueError("not a mozlz4 file")
    src, out, i = raw[12:], bytearray(), 0
    while i < len(src):
        token = src[i]
        i += 1
        ln = token >> 4
        if ln == 15:
            while True:
                b = src[i]
                i += 1
                ln += b
                if b != 255:
                    break
        out += src[i:i + ln]
        i += ln
        if i >= len(src):
            break
        off = src[i] | (src[i + 1] << 8)
        i += 2
        ml = token & 0xF
        if ml == 15:
            while True:
                b = src[i]
                i += 1
                ml += b
                if b != 255:
                    break
        ml += 4
        start = len(out) - off
        for k in range(ml):
            out.append(out[start + k])
    return bytes(out)


def profiles():
    for root in (f"{HOME}/.zen", f"{HOME}/.config/zen"):
        for path in sorted(glob.glob(f"{root}/*/")):
            if os.path.exists(path + "containers.json"):
                yield path.rstrip("/")


def stage_note(stage, reason):
    """Name the stage in every line, because a refusal now belongs to one of
    them and not to the run as a whole."""
    print(f"==> Zen {stage}: {reason}")


def seed_spaces(profile, ids, data):
    """Stage 1. True when spaces were added to data, False when there was
    nothing to add.

    This appends and never replaces, which is a correction of the original
    design rather than a relaxation of it. The old rule was "write only into an
    untouched profile, because this file also holds every open tab", and it was
    measured on 2026-07-30 to be unreachable: launching Zen once, which is the
    step that creates the containers this stage needs, leaves four tabs behind
    (about:blank, the options page of an extension, and two zen-browser.app
    pages) plus a default space called "Space". So the guard fired every time
    and the seeding had never once run on a real machine.

    Appending removes the reason for the guard. Nothing existing is rewritten:
    our spaces go after whatever is there, our essentials are added to the tab
    list, and a context whose space already exists is skipped by name. That also
    makes the stage idempotent and useful on a lived-in profile, which is where
    stage 2 lives anyway.
    """
    have = {s.get("name") for s in data.get("spaces", [])}
    todo = [entry for entry in SEED if entry["name"] not in have]
    if not todo:
        stage_note("spaces", "every context already has a space")
        return False

    spaces, tabs = list(data.get("spaces", [])), list(data.get("tabs", []))
    for entry in todo:
        name = entry["name"]
        space_uuid = "{%s}" % uuid.uuid4()
        context_id = ids[name]
        spaces.append({
            "uuid": space_uuid,
            "name": name,
            "theme": {"type": "gradient", "gradientColors": [], "opacity": 0.5, "texture": 0},
            "containerTabId": context_id,
            "hasCollapsedPinnedTabs": False,
        })
        for mark in entry["bookmarks"]:
            url = mark["url"]
            tabs.append({
                "entries": [{
                    "url": url,
                    "title": mark["title"],
                    "cacheKey": 0,
                    # Session restore drops an entry with no principal. The
                    # field is named base64 but holds JSON in current Gecko:
                    # {"1": content principal} with origin and the container
                    # as an origin attribute.
                    "triggeringPrincipal_base64": json.dumps(
                        {"1": {"0": url, "2": f"^userContextId={context_id}"}}
                    ),
                }],
                "index": 1,
                "pinned": True,
                "hidden": False,
                "zenWorkspace": space_uuid,
                "zenEssential": True,
                "userContextId": context_id,
                "requestedIndex": 0,
            })

    added_spaces = len(todo)
    added_tabs = len(tabs) - len(data.get("tabs", []))
    data["spaces"] = spaces
    data["tabs"] = tabs
    stage_note("spaces", f"added {added_spaces} spaces and {added_tabs} essentials")
    return True


def route_id(name):
    """A deterministic id where Zen itself calls crypto.randomUUID(). Braceless,
    like Zen's own, and stable, which is what idempotence rests on: a random id
    would have every apply append one more rule for the same context."""
    return str(uuid.uuid5(uuid.NAMESPACE_URL, ROUTE_NS + name))


def write_routes(profile, spaces):
    """Stage 2. The rule "the address contains a context name -> its space".

    Zen takes the FIRST match in array order (ZenSpaceRoutingManager routeUri),
    so a second rule on one reference is not litter but a silent change of
    behaviour. Hence conflicts are resolved by meaning and not by id alone.

    The file is not ours as a whole: rules added by hand and
    defaultRouteExternal survive. External links are still sorted by Junction,
    which asks, and that is strictly safer than any fixed default.
    """
    path = f"{profile}/{ROUTE_FILE}"
    doc = {"routes": [], "defaultRouteExternal": "most-recent-space"}
    if os.path.exists(path):
        try:
            doc = json.loads(mozlz4_decompress(open(path, "rb").read()))
            # Shape, not just parsing: a file that decompresses into a list or a
            # string would blow up on doc.get() outside the try, taking the
            # whole apply with it.
            if not isinstance(doc, dict):
                raise ValueError(f"expected an object, got {type(doc).__name__}")
        except Exception as exc:
            # Nothing is written: the file holds the user's own rules, and
            # rewriting it on a guess is worse than leaving routing unset up.
            stage_note("routing", f"cannot read {ROUTE_FILE} ({exc}), leaving it alone")
            return
        if not isinstance(doc.get("routes"), list):
            doc["routes"] = []
        if not isinstance(doc.get("defaultRouteExternal"), str):
            doc["defaultRouteExternal"] = "most-recent-space"
        doc["routes"] = [r for r in doc["routes"] if isinstance(r, dict)]

    before = json.dumps(doc, sort_keys=True)
    for name in ROUTED:
        if name not in spaces:
            stage_note("routing", f"no space named {name} yet, its rule is not written")
            continue
        want = {
            "id": route_id(name),
            "reference": name,
            "matchType": "contains",
            "openIn": spaces[name],
        }
        mine = [i for i, r in enumerate(doc["routes"]) if r.get("id") == want["id"]]
        if mine:
            doc["routes"][mine[0]] = want
            continue
        foreign = [r for r in doc["routes"]
                   if str(r.get("reference", "")).lower() == name.lower()]
        if foreign:
            stage_note("routing", f"a rule for {name} exists and was made by hand, not touching it")
            continue
        doc["routes"].append(want)

    if json.dumps(doc, sort_keys=True) == before:
        stage_note("routing", "rules already match the catalogue")
        return

    payload = json.dumps(doc, separators=(",", ":")).encode()
    tmp = path + ".new"
    with open(tmp, "wb") as fh:
        fh.write(mozlz4_compress(payload))
    os.replace(tmp, path)
    print(f"==> Zen routing: {len(doc['routes'])} rules in {ROUTE_FILE}")


if subprocess.run(["pgrep", "-x", "zen-bin"], capture_output=True).returncode == 0:
    # The one refusal that still ends everything: a running Zen rewrites both
    # files from memory when it exits, so anything written now is discarded.
    stage_note("session", "Zen is running, not touching its session")
    sys.exit(0)

touched = False
for profile in profiles():
    session = f"{profile}/zen-sessions.jsonlz4"
    if not os.path.exists(session):
        continue

    # Both files belong to the browser, both are internal formats, and both are
    # read defensively. Without this a corrupt file, or one that merely changed
    # shape, would throw a python traceback, the script would return non-zero,
    # and `chezmoi apply` would fail as a whole -- over a browser profile the
    # other thirty scripts have nothing to do with.
    try:
        with open(f"{profile}/containers.json") as fh:
            identities = json.load(fh)["identities"]
        ids = {i["name"]: i["userContextId"] for i in identities
               if i.get("public", True) and i.get("name")}
    except Exception as exc:
        stage_note("session", f"cannot read containers.json ({exc}), skipping {profile}")
        continue

    try:
        data = json.loads(mozlz4_decompress(open(session, "rb").read()))
        # Shape, not just parsing: a session that decompresses into a list or a
        # string would blow up on data.get() outside the try, which is the very
        # failure this guard exists to prevent.
        if not isinstance(data, dict):
            raise ValueError("session is not an object")
        # The two keys both stages reach for. `tabs: null` is enough to raise
        # inside seed_spaces, and a spaces list holding anything but objects
        # raises on s.get() -- both outside every try, both fatal to the apply.
        # Declining the profile rather than filtering the odd entries out: an
        # unreadable spaces list means the seeding check "is a context already
        # here" cannot be answered, and answering it wrong overwrites a session.
        tabs, spaces = data.get("tabs", []), data.get("spaces", [])
        if not isinstance(tabs, list) or not isinstance(spaces, list):
            raise ValueError("tabs or spaces is not a list")
        if any(not isinstance(space, dict) for space in spaces):
            raise ValueError("spaces holds something other than objects")
    except Exception as exc:
        stage_note("session", f"cannot read the session ({exc}), leaving {profile} alone")
        continue

    missing = [name for name in CONTEXTS if name not in ids]

    if missing:
        stage_note("spaces", f"no container yet for {', '.join(missing)} -- launch Zen once first")
    elif seed_spaces(profile, ids, data):
        payload = json.dumps(data, separators=(",", ":")).encode()
        tmp = session + ".new"
        with open(tmp, "wb") as fh:
            fh.write(mozlz4_compress(payload))
        os.replace(tmp, session)
        touched = True

    # The space map comes from data rather than from the file on disk: when
    # stage 1 has just seeded the spaces their uuids are already here, so the
    # first seeding and its rules arrive in one apply.
    write_routes(profile, {s.get("name"): s.get("uuid")
                           for s in data.get("spaces", []) if s.get("name")})

if not touched:
    stage_note("spaces", "nothing to add, every profile already has its spaces")
PY
{{- end }}
