#!/bin/bash
{{- if not (has "zen" .enabled) }}
exit 0
{{- else }}
set -euo pipefail

# A ~60-line extension that replaces the fiddliest part of the manual setup:
# assigning a SOCKS proxy to each Firefox container by hand in Multi-Account
# Containers. Doing it by hand cost two silent failure modes -- "socks5://"
# parses to nothing there, and the proxy field does not even appear until an
# optional permission is granted -- and neither says a word when it goes wrong.
#
# Here the table comes from `contexts` in .chezmoidata.yaml, the same source as
# the host bridges and the container units, so a port can no longer disagree
# with itself. The extension also CREATES any missing container, which closes
# the last hole: a name typed by hand that matches nothing gets silently
# created without a proxy.
#
# The config is baked into the XPI rather than delivered through the 3rdparty
# policy and storage.managed. One less moving part, and the file is rebuilt on
# every apply anyway. Policies.sys.mjs:3721 skips its "same addon, don't
# reinstall" shortcut for file: URLs, so a rebuilt XPI is picked up on the next
# start with no version juggling.
#
# Unsigned, and that is only survivable because the policy turns the signature
# check off: Zen's own application defaults set xpinstall.signatures.required to
# true (browser/omni.ja defaults/preferences/firefox.js:27), which overrides the
# false in toolkit's greprefs.js. MOZ_REQUIRE_SIGNING: false in this build does
# not disable the check, it only makes that pref settable rather than constant
# (AddonSettings.sys.mjs:32-48). Without the pref this file was built on every
# apply and installed exactly never: "Download failed -
# ERROR_SIGNEDSTATE_REQUIRED". See 32-browser-extensions for the policy, and
# run_after_zz-next-steps.sh for the check that the add-on is actually loaded.

XPI=/usr/local/lib/zen-context-proxy.xpi
BUILD=$(mktemp -d)
trap 'rm -rf "$BUILD"' EXIT

cat > "$BUILD/manifest.json" <<'MANIFEST'
{
  "manifest_version": 2,
  "name": "Work context proxy",
  "description": "Routes each work container through its own SOCKS5 channel.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "context-proxy@dotfiles.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "proxy",
    "tabs",
    "contextualIdentities",
    "cookies",
    "<all_urls>"
  ],
  "background": { "scripts": ["background.js"] }
}
MANIFEST

# CONTEXTS carries a proxy; PLAIN exists but deliberately gets none, so a
# link with no work session attached leaves through the host. The colour
# rotation here is the same one as in 32-browser-extensions and has to stay in
# step with it: whichever of the two creates the container first decides how it
# looks. plain_context sits outside the rotation for that reason.
cat > "$BUILD/background.js" <<EOF
const CONTEXTS = [
{{- $palette := .context_palette }}
{{- range $i, $c := .contexts }}
  { name: {{ $c.name | quote }}, port: {{ $c.socks }}, color: "{{ index $palette (mod $i (len $palette)) }}", icon: "briefcase" },
{{- end }}
];
const PLAIN = { name: {{ .plain_context.name | quote }}, color: {{ .plain_context.color | quote }}, icon: {{ .plain_context.icon | quote }} };
EOF

cat >> "$BUILD/background.js" <<'JS'

let byStore = new Map();
let ready = null;

// Named lookup, not a stored id: container ids are assigned in creation order
// and differ between machines, so anything that pins one goes stale silently.
async function resolve(spec) {
    let found = await browser.contextualIdentities.query({ name: spec.name });
    if (found.length) {
        return found[0];
    }
    return await browser.contextualIdentities.create({
        name: spec.name,
        color: spec.color,
        icon: spec.icon,
    });
}

async function rebuild() {
    const next = new Map();
    for (const spec of CONTEXTS) {
        try {
            const identity = await resolve(spec);
            next.set(identity.cookieStoreId, {
                type: "socks",          // "socks" is SOCKS5; "socks4" is the old one
                host: "127.0.0.1",
                port: spec.port,
                proxyDNS: true,         // names resolve inside the container, not here
            });
        } catch (e) {
            console.error(`context-proxy: ${spec.name}: ${e}`);
        }
    }
    try {
        await resolve(PLAIN);
    } catch (e) {
        console.error(`context-proxy: ${PLAIN.name}: ${e}`);
    }
    byStore = next;
}

async function handler(info) {
    // No tab means no container to attribute the request to. Firefox sends
    // these for some internal fetches; they go direct, same as in
    // Multi-Account Containers.
    if (info.tabId < 0) {
        return {};
    }
    if (ready) {
        await ready;
    }
    let tab;
    try {
        tab = await browser.tabs.get(info.tabId);
    } catch (e) {
        return {};
    }
    return byStore.get(tab.cookieStoreId) || {};
}

browser.proxy.onRequest.addListener(handler, { urls: ["<all_urls>"] });

for (const event of ["onCreated", "onRemoved", "onUpdated"]) {
    browser.contextualIdentities[event].addListener(() => {
        ready = rebuild();
    });
}

ready = rebuild();
JS

( cd "$BUILD" && zip -q -r -X extension.xpi manifest.json background.js )

sudo install -d /usr/local/lib
sudo install -m 644 "$BUILD/extension.xpi" "$XPI"
echo "==> Context proxy extension built: $XPI"
{{- end }}
