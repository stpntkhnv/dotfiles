#!/bin/bash
set -euo pipefail

# The one and only package installer. The lists below are not hand-written:
# they are assembled from .chezmoidata.yaml for the selected features, which
# is why this file renders into a flat list. That is the point -- run_onchange_
# hashes the RENDERED text, so changing the set of features triggers the
# install by itself, with no manual step and no per-feature script.
#
# To see what would run, without applying:
#   chezmoi execute-template < .chezmoiscripts/run_onchange_before_20-packages.sh.tmpl

{{- $enabled := .enabled }}
{{- $pacman := list }}
{{- $aur := list }}
{{- $npm := list }}
{{- $dotnet := list }}
{{- range .features }}
{{-   if has .key $enabled }}
{{-     if hasKey . "pacman" }}{{ $pacman = concat $pacman .pacman }}{{ end }}
{{-     if hasKey . "aur"    }}{{ $aur    = concat $aur    .aur    }}{{ end }}
{{-     if hasKey . "npm"    }}{{ $npm    = concat $npm    .npm    }}{{ end }}
{{-     if hasKey . "dotnet" }}{{ $dotnet = concat $dotnet .dotnet }}{{ end }}
{{-   end }}
{{- end }}
{{- $pacman = $pacman | uniq | sortAlpha }}
{{- $aur = $aur | uniq | sortAlpha }}
{{- $npm = $npm | uniq | sortAlpha }}
{{- $dotnet = $dotnet | uniq | sortAlpha }}

# Selected features: {{ $enabled | join " " }}

{{- if has "desktop" $enabled }}
# `power-profiles-daemon` ships preinstalled on plenty of Arch laptops
# (archinstall's own desktop profiles pull it), and `tuned-ppd` both Provides
# and Conflicts With it. pacman then asks "Remove power-profiles-daemon?", and
# --noconfirm answers NO -- so the ENTIRE transaction below dies with
# "unresolvable package conflicts", not just that one package. Swap it out
# first. -Rdd because whatever depends on it is satisfied again the moment
# tuned-ppd lands, two lines later.
#
# The test compares the NAME pacman prints, not its exit code: `pacman -Qq
# power-profiles-daemon` resolves provides, so on a machine that already has
# tuned-ppd it succeeds and prints `tuned-ppd` (verified 2026-08-05).
if [[ "$(pacman -Qq power-profiles-daemon 2>/dev/null)" == "power-profiles-daemon" ]]; then
    echo "==> Replacing power-profiles-daemon with tuned-ppd..."
    sudo pacman -Rdd --noconfirm power-profiles-daemon
fi
{{- end }}

echo "==> Installing repository packages ({{ len $pacman }})..."
sudo pacman -Syu --noconfirm --needed \
{{ range $i, $p := $pacman }}    {{ $p }}{{ if lt (add1 $i) (len $pacman) }} \{{ end }}
{{ end }}
{{ if $aur }}
# ---- AUR ----------------------------------------------------------------
# yay is built from source, so it is only needed when something actually
# comes from the AUR. If paru is already present, prefer it.
if ! command -v paru &>/dev/null && ! command -v yay &>/dev/null; then
    echo "==> Building yay..."
    sudo pacman -S --noconfirm --needed base-devel git
    tmpdir=$(mktemp -d)
    git clone --depth 1 https://aur.archlinux.org/yay.git "$tmpdir/yay"
    (cd "$tmpdir/yay" && makepkg -si --noconfirm)
    rm -rf "$tmpdir"
fi
aur=$(command -v paru || command -v yay)

echo "==> Installing AUR packages ({{ len $aur }})..."
"$aur" -S --noconfirm --needed \
{{ range $i, $p := $aur }}    {{ $p }}{{ if lt (add1 $i) (len $aur) }} \{{ end }}
{{ end }}
{{- end }}
{{ if $npm }}
# ---- npm ----------------------------------------------------------------
# Everything global goes to ~/.npm-global, which .bashrc keeps on PATH.
# `npm config set` rewrites ~/.npmrc with an absolute prefix path and creates
# a permanent conflict with the managed file, so only touch it when it
# actually disagrees.
mkdir -p "$HOME/.npm-global"
if [[ "$(npm config get prefix)" != "$HOME/.npm-global" ]]; then
    npm config set prefix "$HOME/.npm-global"
fi

# --allow-scripts on the command line rather than from ~/.npmrc, which says the
# same thing: this is a `before` script, so on a fresh machine it runs while
# that file does not exist yet. npm then blocks the postinstall that links the
# claude native binary, leaving ~/.npm-global/bin/claude as a dangling symlink
# -- and a dangling symlink in PATH reports as "No such file or directory",
# naming a file that is right there.
echo "==> Installing global npm packages..."
npm install -g --allow-scripts=@anthropic-ai/claude-code{{ range $npm }} {{ . | quote }}{{ end }}
{{- end }}
{{ if $dotnet }}
# ---- dotnet tools ----------------------------------------------------------
# `tool update` rather than `tool install`: since .NET 8 it installs when the
# tool is missing and is a no-op when it is current, so the script stays
# idempotent. Tools land in ~/.dotnet/tools, which .bashrc keeps on PATH.
echo "==> Installing global dotnet tools..."
{{- range $dotnet }}
dotnet tool update -g {{ . | quote }}
{{- end }}
{{- end }}

echo "==> Packages done."
