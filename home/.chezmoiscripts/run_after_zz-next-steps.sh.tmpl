#!/bin/bash
set -euo pipefail

# Final checklist. Runs on every apply (no onchange_) because it inspects live
# state: an interactive login cannot happen inside a chezmoi run, so list
# whichever are still missing. Prints nothing once everything is authenticated.

steps=()

{{- if eq .env "host" }}
# The one non-local check in this file: ask GitHub whether our key is
# actually registered. accept-new also seeds known_hosts on a fresh box, so
# the first real git push does not stop at a host-key prompt. When offline
# the step shows up spuriously -- harmless, it disappears on the next apply.
# Host only: in a container the honest advice is not "register this key" but
# "restore the context's key from the vault" -- the block below says exactly
# that, and registering a fresh key would resurrect the old re-registration
# pain this scheme removes.
if ! ssh -T -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=accept-new \
        git@github.com 2>&1 | grep -q "successfully authenticated"; then
    steps+=("GitHub SSH: key not registered -- 'cat ~/.ssh/id_ed25519.pub', paste at https://github.com/settings/keys; if this machine was REINSTALLED, the old, already-registered keys are in the vault instead: 'ssh-restore -f host', then 'chezmoi apply' (docs/install.md)")
fi
{{- end }}
{{- if eq .env "container" }}
if [[ ! -f "$HOME/.ssh/id_ed25519" || ! -f "$HOME/.ssh/id_rsa" ]]; then
    steps+=("SSH: keys for this context live in the KeePassXC vault -- run 'ssh-restore <context>' on the host (docs/secrets.md)")
fi
{{- end }}
{{ if has "claude" .enabled }}
[[ -f "$HOME/.claude/.credentials.json" ]] || \
    steps+=("Claude Code: not logged in -- run 'claude', pick 'Log in' (browser opens claude.ai; /login if you skipped it)")
# chezmoi pulls claudefiles but no longer runs its setup.sh: that run is long,
# interactive and asks its own questions, which has no place inside an apply.
# setup.sh writes last-applied-head itself on success, so this line clears
# after a manual run and reappears when the external pulls a new revision.
cf_dir="$HOME/.local/share/claudefiles"
if [[ -d "$cf_dir/.git" ]]; then
    cf_head="$(git -C "$cf_dir" rev-parse HEAD 2>/dev/null || true)"
    cf_applied="$(cat "$HOME/.config/claudefiles/last-applied-head" 2>/dev/null || true)"
    [[ -n "$cf_head" && "$cf_head" == "$cf_applied" ]] || \
        steps+=("Claude: claudefiles setup is pending -- run: ~/.local/share/claudefiles/setup.sh")
fi
{{- end }}
{{- if has "codex" .enabled }}
[[ -f "$HOME/.codex/auth.json" ]] || \
    steps+=("Codex: not logged in -- 'codex login' (browser OAuth via chatgpt.com) or 'codex login --api-key <key>'")
{{- end }}
{{- if has "gh" .enabled }}
if command -v gh &>/dev/null && ! gh auth status &>/dev/null; then
    steps+=("GitHub CLI: not logged in -- 'gh auth login' (device code at https://github.com/login/device)")
fi
{{- end }}
{{- if has "azure" .enabled }}
if command -v az &>/dev/null && ! az account show &>/dev/null; then
    steps+=("Azure CLI: no active session -- 'az login'")
fi
{{- end }}
{{- if has "ziti" .enabled }}
if [[ -z "$(ls -A /opt/openziti/etc/identities 2>/dev/null)" ]]; then
    steps+=("OpenZiti: no identity -- 'sudo cp <your-identity>.json /opt/openziti/etc/identities/ && sudo systemctl start ziti-edge-tunnel' (the JSON comes from whoever runs your Ziti network; docs/network.md)")
fi
{{- end }}
{{- if has "voice" .enabled }}
# Handy pulls models through the HuggingFace hub cache, not into its own
# models/ directory -- that one stays empty even with a model installed, so
# checking it would warn on every apply.
#
# The pinned model is matched by name and not by a glob over any .gguf: a
# machine still holding only the old turbo weights is exactly the case that
# used to read as "a model is present" while dictation refused to start.
# Handy fails loudly there -- load_model(...) failed: Model not downloaded --
# so the cost of missing this is one dead dictation, not silent drift.
if ! compgen -G "$HOME/.cache/huggingface/hub/models--handy-computer--whisper-large-v3-gguf/snapshots/*/whisper-large-v3-Q8_0.gguf" >/dev/null 2>&1; then
    steps+=("Handy: the pinned model is missing -- run 'handy' and download Whisper Large v3 under Settings -> Model")
fi
# Handy writes settings_store.json on its first start, so on a fresh machine
# 44-handy-settings had nothing to patch and quietly did nothing.
if [[ ! -f "$HOME/.local/share/com.pais.handy/settings_store.json" ]]; then
    steps+=("Handy: never started, so its settings are unconfigured -- run 'handy', then 'chezmoi apply' again")
fi
{{- end }}
{{- if has "keepassxc" .enabled }}
if [[ ! -f "$HOME/Documents/Passwords/personal.kdbx" ]]; then
    steps+=("KeePassXC: create the vault -- keepassxc, Database > New, save as ~/Documents/Passwords/personal.kdbx; Tools > Settings > Browser Integration: enable, tick BOTH Firefox (covers Zen) and Chromium; then Connect from the extension icon in each browser")
    steps+=("KeePassXC phone: install KeePassDX, accept the 'passwords' Syncthing folder, open personal.kdbx")
fi
# `|| true`: this file opens with `set -euo pipefail`, and pacman exits nonzero
# the moment even ONE of the three packages is not found -- without the guard,
# a partial removal (say only `bitwarden` left) would take the whole pipe's
# exit code from pacman, grep would never run, and the reminder would vanish
# while leftovers still sit on disk.
if { pacman -Qq bitwarden rbw bws-bin 2>/dev/null || true; } | grep -q .; then
    steps+=("Bitwarden leftovers: 'sudo pacman -Rns bitwarden rbw bws-bin', then rm -rf ~/.config/rbw ~/.config/bws; delete the vault.bitwarden.eu account LAST, after critical passwords are recreated in KeePassXC")
fi
{{- end }}
{{- if has "tailscale" .enabled }}
if command -v tailscale &>/dev/null && ! tailscale status &>/dev/null; then
    steps+=("Tailscale: not connected -- 'sudo tailscale up' (browser auth)")
fi
{{- end }}
{{- if has "docker" .enabled }}
if ! id -nG "$USER" | grep -qw docker; then
    steps+=("Docker: you are not in the docker group yet -- log out and back in to use it without sudo")
fi
{{- end }}

{{- if eq .env "host" }}
{{- if has "zen" .enabled }}
# Older Zen keeps profiles in ~/.zen, current builds in ~/.config/zen.
zen_root=""
for r in "$HOME/.zen" "$HOME/.config/zen"; do
    [[ -d "$r" ]] && zen_root="$r"
done

if [[ -z "$zen_root" ]]; then
    steps+=("Zen: never launched -- run 'zen-browser' once, then 'chezmoi apply' to write user.js")
else
    compgen -G "$zen_root/*/user.js" >/dev/null 2>&1 || \
        steps+=("Zen: prefs not applied -- run 'chezmoi apply' with Zen closed")

    # The three extensions that carry the container boundary. Policies install
    # them, but a policy that never took (wrong path, a GUID that matches no
    # add-on, an unsigned XPI on a build that wants a signature) fails silently,
    # and a silent failure here means every context shares one cookie jar.
    #
    # extensions.json rather than the presence of the .xpi file: a file left over
    # from an earlier install says nothing about whether the add-on loaded, and
    # an appDisabled add-on has a file too. `active` is the field that answers
    # the actual question. jq is present on any host that has a browser feature.
    for ext in "@testpilot-containers" "{f069aec0-43c5-4bbf-b6b4-df95c4326b98}" "context-proxy@dotfiles.local"; do
        live=""
        for db in "$zen_root"/*/extensions.json; do
            [[ -f "$db" ]] || continue
            if [[ "$(jq -r --arg id "$ext" \
                     '[.addons[]? | select(.id == $id and .active == true)] | length' \
                     "$db" 2>/dev/null || echo 0)" != "0" ]]; then
                live=1
                break
            fi
        done
        [[ -n "$live" ]] || \
            steps+=("Zen: extension $ext is not loaded -- check about:policies and about:addons; 'chezmoi apply' rebuilds the policy and the XPI")
    done
fi

# Our own extension is unsigned, which only loads because Zen ships
# MOZ_REQUIRE_SIGNING: false. A build that flips it would drop the proxies
# without a word, so check the file the policy points at actually exists.
[[ -f /usr/local/lib/zen-context-proxy.xpi ]] || \
    steps+=("Zen: the context proxy extension was never built -- run 'chezmoi apply'")

# Zen grabs x-scheme-handler/http(s) on its first launch, before user.js can
# turn browser.shell.checkDefaultBrowser off. Re-assert rather than warn: the
# script that sets it is run_onchange and will not fire again on its own.
if [[ "$(xdg-mime query default x-scheme-handler/https 2>/dev/null)" != *[Jj]unction* ]]; then
    if junction_id=$(pacman -Ql junction 2>/dev/null | grep -o '[^/]*\.desktop$' | head -1) && [[ -n "$junction_id" ]]; then
        xdg-mime default "$junction_id" x-scheme-handler/http x-scheme-handler/https
        echo "==> Link handler reclaimed from the browser: $junction_id"
    else
        steps+=("Links: Junction is not the default https handler and the package is missing -- 'sudo pacman -S junction', then 'chezmoi apply' (it reclaims the handler)")
    fi
fi
{{- end }}
{{- if has "syncthing" .enabled }}
# Six different causes with one appearance from outside: everything configured,
# nothing synchronising. Each one gets its own line with the command that fixes
# it, because guessing which of the six it is costs an evening.
st_conf="$(syncthing paths 2>/dev/null | grep -oE '[^[:space:]]*config\.xml' | head -1 || true)"
if [[ -z "$st_conf" || ! -f "$st_conf" ]]; then
    steps+=("Syncthing: no configuration yet -- run 'chezmoi apply' once the service has started")
else
    st_key="$(sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' "$st_conf" | head -1)"
    st_addr="$(awk '/<gui/,/<\/gui>/' "$st_conf" | sed -n 's:.*<address>\(.*\)</address>.*:\1:p' | head -1)"
    [[ -n "$st_addr" ]] || st_addr="127.0.0.1:8384"
    st_api() { curl -sf --max-time 5 -H "X-API-Key: $st_key" "http://$st_addr$1" 2>/dev/null; }

    if ! systemctl --user is-active --quiet syncthing.service; then
        steps+=("Syncthing: the user service is not running -- 'systemctl --user enable --now syncthing.service'")
    fi

    # Every assignment below ends in `|| true`. This file opens with
    # `set -euo pipefail`, and an unreachable daemon would otherwise take the
    # WHOLE checklist down -- not just the Syncthing lines, but GitHub, Tailscale
    # and everything else in it.
    st_myid="$(st_api /rest/system/status | jq -r '.myID // empty' || true)"
    # Same runtime device map as script 46; here every abnormal state becomes a
    # checklist line rather than a say(), because this file IS the checklist.
    # /usr/bin/yq by full path for the same reason as there: a python yq earlier
    # in PATH takes different flags.
    st_devmap="$HOME/.config/syncthing-devices.yaml"
    st_devices='{}'
    if [[ ! -f "$st_devmap" ]]; then
        :   # the map-absence step below speaks, with a paste-ready skeleton
    elif [[ ! -x /usr/bin/yq ]]; then
        steps+=("Syncthing: go-yq is not installed, the device map cannot be read -- 'chezmoi apply' should install it")
    else
        st_devices="$(/usr/bin/yq -o=json '.' "$st_devmap" 2>/dev/null || true)"
        if [[ -z "$st_devices" ]] || ! jq -e 'type == "object"' <<<"$st_devices" >/dev/null 2>&1; then
            steps+=("Syncthing: device map exists but did not parse -- fix $st_devmap")
            st_devices='{}'
        else
            # Same sanitising as script 46, for the same reason: one malformed
            # entry must not break self-matching and make this checklist claim
            # the machine is not in the map at all.
            while IFS= read -r st_bad; do
                [[ -n "$st_bad" ]] || continue
                steps+=("Syncthing: device map entry '$st_bad' is malformed (needs id and addresses) -- fix $st_devmap")
            done < <(jq -rn --argjson d "$st_devices" \
                '$d | to_entries[] | select(((.value | type) != "object") or ((.value.id? | type) != "string") or ((.value.addresses? | type) != "array")) | .key')
            st_devices="$(jq -c 'with_entries(select(((.value | type) == "object") and ((.value.id? | type) == "string") and ((.value.addresses? | type) == "array")))' <<<"$st_devices")"
        fi
    fi
    # Quoted heredoc rather than a single-quoted assignment: an apostrophe in a
    # folder label would otherwise end the string early and take this whole file
    # down, checklist included.
    st_catalog="$(cat <<'SYNCTHING_CATALOG_EOF'
{{ .syncthing.folders | toJson }}
SYNCTHING_CATALOG_EOF
)"
    st_self="$(jq -rn --argjson d "$st_devices" --arg id "$st_myid" \
        '[$d | to_entries[] | select(.value.id == $id) | .key] | first // empty' 2>/dev/null || true)"

    if [[ -n "$st_myid" && -z "$st_self" ]]; then
        steps+=("Syncthing: this machine is not in the device map -- create ~/.config/syncthing-devices.yaml with:  <name>:  id: \"$st_myid\"  addresses: [\"dynamic\", \"tcp://<host>.<tailnet>.ts.net:22000\"]  -- where <name> is one of the catalogue device names (desktop | laptop | phone; a made-up name silently gets no folders); then 'chezmoi apply' here and add the same entry on every other machine")
    fi

    # Pairing is mutual, so a device named in the catalogue but absent from the
    # map means a folder is quietly synchronising with one participant fewer
    # than it claims. Iterated in bash over a deduplicated list rather than in
    # the template: `laptop` is named by three folders and deserves one line,
    # not three.
    while IFS= read -r st_name; do
        [[ -n "$st_name" ]] || continue
        if [[ "$(jq -rn --argjson d "$st_devices" --arg n "$st_name" '$d[$n].id // empty')" == "" ]]; then
            steps+=("Syncthing: device '$st_name' is named in the catalogue but has no ID in the map -- run 'chezmoi apply' on it and copy the ID it prints")
        fi
    done < <(jq -rn --argjson c "$st_catalog" '[$c[].devices[]] | unique[]')

    # Only folders this machine takes part in. `camera` is deliberately absent on
    # the laptop, and a check that does not know that would demand it forever.
    if [[ -n "$st_self" ]]; then
        st_have="$(st_api /rest/config/folders | jq -r '.[].id' || true)"
        while IFS= read -r st_fid; do
            grep -qx "$st_fid" <<<"$st_have" || \
                steps+=("Syncthing: folder '$st_fid' is not configured -- run 'chezmoi apply'")
        done < <(jq -rn --argjson c "$st_catalog" --arg s "$st_self" '$c[] | select(.devices | index($s)) | .id')
    fi

    # Without myID this cannot tell the local machine from a remote one, and an
    # empty stats reply makes every device look never-seen -- so it would say
    # this very box has never been seen, beside the true line about the service
    # being down. The rule in this file is silence when it cannot look.
    if [[ -n "$st_myid" ]]; then
        # lastSeen rather than the current connection state: a sleeping laptop is not
        # an unpaired one, and a check that cries every day gets ignored.
        st_stats="$(st_api /rest/stats/device || true)"
        [[ -n "$st_stats" ]] || st_stats='{}'
        while IFS= read -r st_pair; do
            st_name="${st_pair%% *}"; st_id="${st_pair##* }"
            [[ "$st_id" == "$st_myid" ]] && continue
            # `|| true` here too, and the reason is subtler than for the others: the
            # `[[ -n "$st_stats" ]]` fallback above only catches a wholly empty reply.
            # A curl cut off mid-transfer leaves a non-empty but truncated body, jq
            # fails to parse it, and an unguarded assignment would take the whole
            # checklist down -- including every item that has nothing to do with
            # Syncthing. Empty here means "cannot tell", which prints nothing.
            st_seen="$(jq -r --arg id "$st_id" '.[$id].lastSeen // "0001-01-01T00:00:00Z"' <<<"$st_stats" || true)"
            if [[ "$st_seen" == 0001-01-01* ]]; then
                steps+=("Syncthing: device '$st_name' has never been seen -- it has to add this machine's ID too (paired from one side only)")
            fi
        done < <(jq -rn --argjson d "$st_devices" '$d | to_entries[] | "\(.key) \(.value.id)"')
    fi

    # Outside the guard above on purpose: this reads the map and nothing else,
    # so it keeps working when the daemon does not. It checks the local entry
    # too, because the address recorded here is what other machines dial.
    while IFS= read -r st_name; do
        [[ -n "$st_name" ]] || continue
        # A map entry with `dynamic` alone is the quietest failure of the lot:
        # everything looks configured and the device is simply unreachable the
        # moment it leaves the home network, because global discovery is off.
        #
        # An address still carrying <angle brackets> counts as absent. The tailnet
        # domain cannot be known before `tailscale up`, so writing a placeholder is
        # the honest thing to do -- but it begins with tcp:// and would sail through
        # a check that only looked at the scheme.
        if [[ "$(jq -rn --argjson d "$st_devices" --arg n "$st_name" \
                 '[$d[$n].addresses[]? | select(startswith("tcp://")) | select(test("[<>]") | not)] | length')" == "0" ]]; then
            steps+=("Syncthing: device '$st_name' has no usable static address -- put \"tcp://<name>.<tailnet>.ts.net:22000\" beside \"dynamic\" in ~/.config/syncthing-devices.yaml with the real tailnet name from 'tailscale status', or the device is only reachable on the local network")
        fi
    done < <(jq -rn --argjson d "$st_devices" '$d | keys[]')

    # `ufw status` needs root, and this file must never ask for a password. During
    # a real apply the sudo timestamp is still warm from 30-system, so the check
    # runs; standalone it stays silent instead of reporting closed ports it could
    # not actually look at.
    if sudo -n true 2>/dev/null; then
        st_ufw="$(sudo -n ufw status 2>/dev/null || true)"
        for st_port in 22000/tcp 22000/udp 21027/udp; do
            if ! grep -q "^${st_port%%/*}.*${st_port##*/}.*ALLOW" <<<"$st_ufw"; then
                steps+=("Syncthing: incoming $st_port is closed -- 'sudo ufw allow $st_port' (30-system only adds these once, when its own text changes, so a later apply will not put them back)")
                break
            fi
        done
    fi

    # A conflict file is an ordinary .md to an agent, and its name no longer
    # matches the `name:` in its front matter, which is what [[links]] stand on.
    while IFS= read -r st_path; do
        while IFS= read -r st_conflict; do
            case "$st_conflict" in
                # A .kdbx conflict is not a text file; kb-curate would be
                # nonsense. KeePassXC merges databases natively.
                *.kdbx*) steps+=("Syncthing: conflict file $st_conflict -- merge in KeePassXC (Database > Merge from database), then delete the conflict copy") ;;
                *) steps+=("Syncthing: conflict file $st_conflict -- resolve with the kb-curate skill, do not delete blindly") ;;
            esac
        done < <(find "$HOME/$st_path" -name '*.sync-conflict-*' -type f 2>/dev/null)
    done < <(jq -rn --argjson c "$st_catalog" --arg s "${st_self:-none}" '$c[] | select(.devices | index($s)) | .path')

    # The vault path is owned by claudefiles, not by this repository. If the two
    # disagree, the agents read one directory while Syncthing dutifully mirrors
    # another, and both halves look healthy.
    st_secrets="$HOME/.config/claudefiles/secrets.json"
    if [[ -f "$st_secrets" ]] && [[ "$(jq -r '.flags.kb // false' "$st_secrets" 2>/dev/null)" == "true" ]]; then
        st_vault="$(jq -r '.kb.vault_path // ""' "$st_secrets" 2>/dev/null || true)"
        st_vault="${st_vault/#\~/$HOME}"
        [[ -z "$st_vault" ]] && st_vault="$HOME/Documents/Notes/kb"
        st_kb="$HOME/$(jq -rn --argjson c "$st_catalog" '$c[] | select(.id == "kb") | .path' || true)"
        if [[ "${st_vault%/}" != "$st_kb" ]]; then
            steps+=("Syncthing: claudefiles syncs the vault at $st_vault but the catalogue syncs $st_kb -- edit kb.vault_path in ~/.config/claudefiles/secrets.json to match the catalogue path, then rerun ~/.local/share/claudefiles/setup.sh")
        fi
    fi
fi
{{- end }}
{{- range .contexts }}
[[ -S "$HOME/.local/share/wsproxy/{{ .name }}/socks.sock" ]] || \
    steps+=("Proxy {{ .name }}: no socket -- start the container ('distrobox enter {{ .name }} -- true') and check wsproxy-bridge.service inside it")
{{- end }}
{{- end }}

if ((${#steps[@]} > 0)); then
    echo ""
    echo "================ NEXT STEPS ================"
    for s in "${steps[@]}"; do
        echo "  * $s"
    done
    echo "============================================"
fi
