#!/bin/bash
set -euo pipefail

# Final checklist. Runs on every apply (no onchange_) because it inspects live
# state: an interactive login cannot happen inside a chezmoi run, so list
# whichever are still missing. Prints nothing once everything is authenticated.

steps=()

# The one non-local check in this file: ask GitHub whether our key is
# actually registered. accept-new also seeds known_hosts on a fresh box, so
# the first real git push does not stop at a host-key prompt. When offline
# the step shows up spuriously -- harmless, it disappears on the next apply.
if ! ssh -T -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=accept-new \
        git@github.com 2>&1 | grep -q "successfully authenticated"; then
    steps+=("GitHub SSH: key not registered -- 'cat ~/.ssh/id_ed25519.pub', paste at https://github.com/settings/keys")
fi
{{ if has "claude" .enabled }}
[[ -f "$HOME/.claude/.credentials.json" ]] || \
    steps+=("Claude Code: not logged in -- run 'claude', pick 'Log in' (browser opens claude.ai; /login if you skipped it)")
{{- end }}
{{- if has "codex" .enabled }}
[[ -f "$HOME/.codex/auth.json" ]] || \
    steps+=("Codex: not logged in -- 'codex login' (browser OAuth via chatgpt.com) or 'codex login --api-key <key>'")
{{- end }}
{{- if has "gh" .enabled }}
if command -v gh &>/dev/null && ! gh auth status &>/dev/null; then
    steps+=("GitHub CLI: not logged in -- 'gh auth login' (device code at https://github.com/login/device)")
fi
{{- end }}
{{- if has "azure" .enabled }}
if command -v az &>/dev/null && ! az account show &>/dev/null; then
    steps+=("Azure CLI: no active session -- 'az login'")
fi
{{- end }}
{{- if has "ziti" .enabled }}
if [[ -z "$(ls -A /opt/openziti/etc/identities 2>/dev/null)" ]]; then
    steps+=("OpenZiti: no identity -- copy the JSON to /opt/openziti/etc/identities/ and 'sudo systemctl start ziti-edge-tunnel'")
fi
{{- end }}
{{- if has "voice" .enabled }}
# Handy pulls models through the HuggingFace hub cache, not into its own
# models/ directory -- that one stays empty even with a model installed, so
# checking it would warn on every apply. Look for the downloaded weights.
if ! compgen -G "$HOME/.cache/huggingface/hub/models--*/snapshots/*/*.gguf" >/dev/null 2>&1; then
    steps+=("Handy: no model downloaded -- run 'handy' and pick one in Settings -> Model")
fi
{{- end }}
{{- if has "bitwarden" .enabled }}
if command -v rbw &>/dev/null; then
    [[ -s "$HOME/.config/rbw/config.json" ]] || \
        steps+=("Bitwarden: account at https://vault.bitwarden.com (register if new), then 'rbw config set email <email>' and 'rbw login'")
fi
if command -v bws &>/dev/null && [[ ! -s "$HOME/.config/bws/access-token" ]]; then
    steps+=("Bitwarden agents: create a Secrets Manager machine account at https://vault.bitwarden.com -> Secrets Manager -> Machine accounts, put its token in ~/.config/bws/access-token (chmod 600)")
fi
{{- end }}
{{- if has "tailscale" .enabled }}
if command -v tailscale &>/dev/null && ! tailscale status &>/dev/null; then
    steps+=("Tailscale: not connected -- 'sudo tailscale up' (browser auth)")
fi
{{- end }}
{{- if has "docker" .enabled }}
if ! id -nG "$USER" | grep -qw docker; then
    steps+=("Docker: you are not in the docker group yet -- log out and back in to use it without sudo")
fi
{{- end }}

{{- if eq .env "host" }}
{{- if has "zen" .enabled }}
[[ -d "$HOME/.zen" ]] || \
    steps+=("Zen: never launched -- run 'zen-browser' once, then 'chezmoi apply' to write user.js")

if [[ -d "$HOME/.zen" ]] && ! compgen -G "$HOME/.zen/*/user.js" >/dev/null 2>&1; then
    steps+=("Zen: prefs not applied -- run 'chezmoi apply' with Zen closed")
fi

# The two extensions that carry the container boundary. Policies install them,
# but a policy that never took (wrong path, Zen ignoring /etc/firefox) fails
# silently, and a silent failure here means every context shares one cookie jar.
if [[ -d "$HOME/.zen" ]]; then
    for ext in "@testpilot-containers" "{f069aec0-43c5-4bbf-b6b4-df95c4326b98}"; do
        compgen -G "$HOME/.zen/*/extensions/$ext.xpi" >/dev/null 2>&1 || \
            steps+=("Zen: extension $ext is missing -- check about:policies, install from addons.mozilla.org if the policy did not take")
    done
fi

if [[ "$(xdg-mime query default x-scheme-handler/https 2>/dev/null)" != *[Jj]unction* ]]; then
    steps+=("Links: Junction is not the default https handler -- run 'chezmoi apply'")
fi
{{- end }}
{{- range .contexts }}
[[ -S "$HOME/.local/share/wsproxy/{{ .name }}/socks.sock" ]] || \
    steps+=("Proxy {{ .name }}: no socket -- start the container ('distrobox enter {{ .name }} -- true') and check wsproxy-bridge.service inside it")
{{- end }}
{{- end }}

if ((${#steps[@]} > 0)); then
    echo ""
    echo "================ NEXT STEPS ================"
    for s in "${steps[@]}"; do
        echo "  * $s"
    done
    echo "============================================"
fi
