#!/bin/bash
{{- if not (has "desktop" .enabled) }}
exit 0
{{- else }}
set -euo pipefail

# config.kdl includes several files from dms/ that DankMaterialShell generates
# itself (colors, layout, alttab, outputs -- they carry an "AUTO-GENERATED BY
# DMS" header). They are not in the repository and should not be: DMS rewrites
# them on every theme change, and chezmoi would fight it forever.
#
# But on a clean machine they are not on disk either, and niri has no
# conditional include: it fails to find the file, bails out while parsing the
# config and falls back to the default one. In other words, until DMS had run
# once the desktop came up as somebody else's.
#
# So the missing files are created empty -- an empty KDL document is valid as
# far as niri is concerned, and DMS then overwrites them with real content.
#
# The list is not hardcoded: the included paths are read out of config.kdl
# itself, so adding a new include does not require touching this script.

NIRI_DIR="{{ .chezmoi.homeDir }}/.config/niri"
CONFIG="$NIRI_DIR/config.kdl"

[[ -f "$CONFIG" ]] || exit 0

created=0
while IFS= read -r rel; do
    target="$NIRI_DIR/$rel"
    if [[ ! -e "$target" ]]; then
        mkdir -p "$(dirname "$target")"
        printf '// chezmoi placeholder: DankMaterialShell will overwrite this file.\n' > "$target"
        echo "==> Created placeholder $rel"
        created=$((created + 1))
    fi
done < <(grep -oP '^\s*include\s+"\K[^"]+' "$CONFIG")

if ((created == 0)); then
    echo "==> Every include in config.kdl is present."
fi
{{- end }}
