#!/bin/bash
{{- if not (has "zen" .enabled) }}
exit 0
{{- else }}
set -euo pipefail

# user.js rather than an enterprise policy: policies cover only a subset of
# preferences, and Zen hides its profiles behind about:profiles, so there is no
# stable path to check a file into. user.js is re-applied at every start, which
# is what we want -- these are not suggestions.
#
# Profiles do not exist until Zen has been launched once. Nothing to do then;
# the reminder lives in run_after_zz-next-steps.sh.

# Two roots because Zen moved: older builds keep profiles in ~/.zen, current
# ones in ~/.config/zen. Whichever exists gets the prefs; both, if both do.
ZEN_ROOTS=(
    "{{ .chezmoi.homeDir }}/.zen"
    "{{ .chezmoi.homeDir }}/.config/zen"
)

read -r -d '' PREFS <<'JS' || true
// Managed by chezmoi -- .chezmoiscripts/run_onchange_after_40-zen-prefs.sh

// media.peerconnection.ice.proxy_only is deliberately ABSENT, and the absence
// is a decision (2026-07-31), not an oversight. With it, every browser call
// was dead in every space: prefs are profile-wide, the no-proxy containers had
// zero permitted paths, and Firefox cannot push call media through SOCKS, so
// the proxied ones had zero too. Without it, call media (WebRTC only -- tabs
// still obey the proxy) leaves directly from the host, so a call made from a
// work tab shows the home IP to the tenant. The owner ruled the home IP not
// confidential; docs/isolation.md carries this under "Constraints".

// Web push is a notification surface during screen sharing.
user_pref("permissions.default.desktop-notification", 2);

// ext+container: is how a URL carries its container in the link itself.
// Without the second pref every hand-off stops at a confirmation dialog.
user_pref("network.protocol-handler.external.ext+container", true);
user_pref("security.external_protocol_requires_permission", false);

// Passwords live in KeePassXC. Browser autofill would replay the exact leak
// scenario: a foreign tenant's login page loads, credentials get submitted,
// the sign-in shows up in that tenant's logs.
user_pref("signon.rememberSignons", false);
user_pref("signon.autofillForms", false);

// Memory. fission.autostart is deliberately NOT touched: site isolation costs
// RAM but breaking it for a few hundred megabytes is a bad trade.
user_pref("browser.tabs.unloadOnLowMemory", true);
user_pref("dom.ipc.processCount", 4);
// 28 pinned tabs load eagerly at startup and stay resident -- measured 8.58
// GiB total, with single tabs (Teams, ADO) above 2 GB. On demand, a pinned
// tab costs nothing until clicked. The price is that the first click waits.
user_pref("browser.sessionstore.restore_pinned_tabs_on_demand", true);

// Zen claims x-scheme-handler/http(s) on first launch and writes itself into
// mimeapps.list as userapp-Zen-*.desktop. That silently replaces the link
// picker: every link would then open in whatever container the current
// workspace uses. The default handler must stay Junction.
user_pref("browser.shell.checkDefaultBrowser", false);

// Gecko exempts localhost from proxying by default, which here means a work
// tab asking for 127.0.0.1 reaches the HOST rather than that context's
// container: a dev server running inside the container is unreachable from
// its own tab, while every host port is reachable from every context. The
// proxy is ours, so letting it claim localhost is what the design already
// assumes. Also what makes the loopback-marker routing test possible.
user_pref("network.proxy.allow_hijacking_localhost", true);
JS

# Profile directory names contain spaces ("<hash>.Default (alpha)"), hence the
# quoted glob rather than find/read plumbing. "Profile Groups" is a Zen
# bookkeeping directory, not a profile, and carries neither marker file.
found=0
for root in "${ZEN_ROOTS[@]}"; do
    [[ -d "$root" ]] || continue
    for prof in "$root"/*/; do
        [[ -e "$prof/prefs.js" || -e "$prof/times.json" ]] || continue
        printf '%s\n' "$PREFS" > "$prof/user.js"
        echo "==> Zen prefs written to $prof"
        found=1
    done
done

((found)) || echo "Zen has not created a profile yet, skipping prefs."
{{- end }}
