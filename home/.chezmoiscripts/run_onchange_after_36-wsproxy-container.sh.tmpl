#!/bin/bash
{{- if ne .env "container" }}
exit 0
{{- else }}
set -euo pipefail

# microsocks listens on this container's loopback; socat republishes it on a
# UNIX socket in /var/lib/wsproxy, the one directory shared with the host. The
# host browser dials that socket, so every request it sends for this work
# context leaves through THIS container's netns, resolver and VPN.
#
# Not /mnt: distrobox-init bind-mounts the host's /mnt over the container's at
# every start, hiding a podman volume placed there. See distrobox.ini.tmpl.
#
# Both units run as the user rather than root. distrobox creates containers
# with --userns keep-id, which maps container uid 1000 to host uid 1000 but
# container root to a subuid: a root-owned socket would be unreachable from
# the host browser.
#
# System units rather than user units because the container runs systemd as
# init (init=true in distrobox.ini) and there is no logind session inside.

if [[ ! -d /var/lib/wsproxy ]]; then
    echo "!! /var/lib/wsproxy is not mounted: this container predates the volume."
    echo "!! Recreate it: distrobox rm $(. /run/.containerenv; echo "$name") &&"
    echo "!!   distrobox assemble create --name ... --file ~/.config/distrobox/distrobox.ini"
    exit 0
fi

echo "==> Installing the browser proxy units..."

sudo tee /etc/systemd/system/wsproxy-socks.service >/dev/null <<'UNIT'
[Unit]
Description=SOCKS5 server for the host browser
After=network.target

[Service]
User={{ .chezmoi.username }}
ExecStart=/usr/bin/microsocks -i 127.0.0.1 -p 1080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

sudo tee /etc/systemd/system/wsproxy-bridge.service >/dev/null <<'UNIT'
[Unit]
Description=UNIX-socket bridge to the host browser
Requires=wsproxy-socks.service
After=wsproxy-socks.service

[Service]
User={{ .chezmoi.username }}
ExecStart=/usr/bin/socat UNIX-LISTEN:/var/lib/wsproxy/socks.sock,fork,mode=600,unlink-early TCP:127.0.0.1:1080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

sudo systemctl daemon-reload
sudo systemctl enable --now wsproxy-socks.service wsproxy-bridge.service
{{- end }}
