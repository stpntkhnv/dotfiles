{{- $isContainer := false -}}
{{- if stat "/run/.containerenv" -}}
{{-   $isContainer = true -}}
{{- end -}}

{{/* Every option is prompted the same way on host and in containers.
     Environment-specific availability is decided here, in one place:
     an option unavailable in the current environment is not prompted,
     forced to false, and announced — instead of being silently baked
     into the install scripts via CONTAINER_ID checks. */}}

{{- if $isContainer -}}
{{-   writeToStdout "==> Container environment detected: all options below apply inside this container.\n" -}}
{{- else -}}
{{-   writeToStdout "==> Host environment detected: container-only options (Teams, OpenZiti) are unavailable and will be skipped.\n" -}}
{{- end -}}

{{- $gitName := promptStringOnce . "git_name" "Git user name" -}}
{{- $gitEmail := promptStringOnce . "git_email" "Git user email" -}}

{{/* ---- available everywhere ---- */}}
{{- $setupClaude := promptBoolOnce . "setup_claude" "Install Claude Code CLI" -}}
{{- $setupCodex := promptBoolOnce . "setup_codex" "Install OpenAI Codex CLI" -}}
{{- $setupGithubCli := promptBoolOnce . "setup_github_cli" "Install GitHub CLI (gh)" -}}
{{- $setupAzure := promptBoolOnce . "setup_azure" "Setup Azure CLI and tools" -}}

{{/* ---- voice input ----
     Handy runs Whisper locally and offloads it to the GPU through Vulkan
     (not CUDA), so the only thing an NVIDIA card needs is the proprietary
     driver plus its Vulkan ICD. Probe for that here rather than in the
     install script: a missing driver needs a reboot, so the user has to be
     told at init time, not halfway through an apply. Detection reads
     /sys/bus/pci directly -- lspci lives in pciutils, which a minimal Arch
     install does not necessarily have. */}}
{{- $setupVoice := promptBoolOnce . "setup_voice" "Setup voice input (speech-to-text)" -}}
{{- $voiceBackend := "handy" -}}
{{- $setupVoiceGpu := false -}}
{{- if and $setupVoice (not $isContainer) -}}
{{-   $voiceBackend = promptChoiceOnce . "voice_backend" "Voice input backend" (list "handy") -}}
{{-   $hasNvidia := eq (output "sh" "-c" "for d in /sys/bus/pci/devices/*/; do c=$(cat \"$d/class\" 2>/dev/null); v=$(cat \"$d/vendor\" 2>/dev/null); case \"$c\" in 0x030*) [ \"$v\" = 0x10de ] && { echo yes; exit 0; };; esac; done; echo no" | trim) "yes" -}}
{{-   $gpuReady := eq (output "sh" "-c" "[ -e /dev/nvidiactl ] && [ -e /usr/share/vulkan/icd.d/nvidia_icd.json ] && echo yes || echo no" | trim) "yes" -}}
{{-   if and $hasNvidia (not $gpuReady) -}}
{{-     writeToStdout "==> An NVIDIA GPU is present but its driver or Vulkan runtime is missing.\n    Without it Whisper falls back to the CPU, which is several times slower.\n" -}}
{{-     $setupVoiceGpu = promptBoolOnce . "setup_voice_gpu" "Install the NVIDIA driver and Vulkan runtime" -}}
{{-   else if $hasNvidia -}}
{{-     writeToStdout "==> NVIDIA GPU with a working Vulkan runtime detected: Whisper will use it.\n" -}}
{{-   else -}}
{{-     writeToStdout "==> No NVIDIA GPU detected: Whisper will run on whatever Vulkan device is available, or on the CPU.\n" -}}
{{-   end -}}
{{- end -}}

{{/* ---- container-only ---- */}}
{{- $setupZiti := false -}}
{{- $setupTeams := false -}}
{{- $teamsMemoryLimit := "1536M" -}}
{{- if $isContainer -}}
{{-   $setupZiti = promptBoolOnce . "setup_ziti" "Setup OpenZiti edge tunnel" -}}
{{-   $setupTeams = promptBoolOnce . "setup_teams" "Install Microsoft Teams" -}}
{{-   if $setupTeams -}}
{{-     $teamsMemoryLimit = promptStringOnce . "teams_memory_limit" "Teams memory limit (default 1536M)" -}}
{{-   end -}}
{{- end -}}

[git]
    autoCommit = true
    autoPush = true

[data]
    git_name = {{ $gitName | quote }}
    git_email = {{ $gitEmail | quote }}
    is_container = {{ $isContainer }}
    setup_claude = {{ $setupClaude }}
    setup_codex = {{ $setupCodex }}
    setup_github_cli = {{ $setupGithubCli }}
    setup_azure = {{ $setupAzure }}
    setup_voice = {{ $setupVoice }}
    voice_backend = {{ $voiceBackend | quote }}
    setup_voice_gpu = {{ $setupVoiceGpu }}
    setup_ziti = {{ $setupZiti }}
    setup_teams = {{ $setupTeams }}
    teams_memory_limit = {{ $teamsMemoryLimit | quote }}
