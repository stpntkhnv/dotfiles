{{- $badge := includeTemplate "context-badge" (dict "root" .) | trim -}}
{{- $ctx := index (splitList " " $badge) 0 -}}
{{- $herdr := has "herdr" .enabled -}}
{{- $tmux := has "tmux" .enabled -}}
{{- $dotnetenv := ternary "DOTNET_gcServer=0 DOTNET_GCConserveMemory=5 MSBUILDDISABLENODEREUSE=1 " "" (has "dotnet" .enabled) -}}
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[{{ $ctx }} \u@\h \W]\$ '

# ~/.local/bin holds claude (native install) and distrobox-exported bins;
# bash never reads ~/.profile (bash_profile shadows it), so add it here.
export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:$HOME/.dotnet/tools:$PATH"

{{ if eq .env "host" }}
# distrobox container shortcuts, generated from `contexts:` so the list of work
# contexts lives in one place, like every other consumer of it.
#
# The bare name is a shell inside the container. It used to start herdr in
# there; herdr now runs on the host and these are what you type INSIDE one of
# its panes. See the Multiplexer section of the README.
#
# --no-workdir on every single one of them, and it is not cosmetic. Without it
# distrobox carries the host's working directory into the container through
# /run/host, so the shell lands in the host's files while sitting in the
# container's netns -- the worst of both. Measured:
#     distrobox enter digi3 -- pwd               -> /run/host/home/stsiapan
#     distrobox enter --no-workdir digi3 -- pwd  -> /home/stsiapan/homes/digi3
#
# HERDR_AGENT is what makes the agent visible in herdr's sidebar, and it rides
# on the ENTRY, not only on the claude twin. herdr identifies the agent in a
# pane from the foreground process group on the HOST side; through
# `distrobox enter` that group is distrobox and podman, and the real claude sits
# on a different pty inside the container where herdr cannot see it. So a claude
# started by hand after entering the shell is in no agent list at all, which is
# the whole reason herdr is here.
#
# Labelling the pane at entry fixes that case, and the state stays live rather
# than frozen: herdr reads idle/working/blocked off the screen, and the screen
# does cross the container boundary. Measured on 0.7.5 with a real claude in a
# container pane, entered as a plain shell and launched by hand:
#     shell only     agent=claude status=idle    (no rule matches a bare shell)
#     claude running agent=claude status=idle    (rule live_prompt_box)
#     a prompt       status=working, title "⠐ Claude Code", then idle or done
#
# The hint has to be HERE and nowhere else. Exporting HERDR_AGENT inside the
# container does nothing at all -- verified, agent=None -- because herdr reads
# the environment of the process it spawned itself, which is the host-side
# podman. Exporting it globally in this file would go the other way and label
# every pane on the machine, host panes included.
#
# The price, and it is real: a pane holding nothing but a context shell is
# listed in the sidebar as an idle claude agent, and so is one running tmux or
# an editor in that context. The state is honest (nothing is claimed to be
# working), the row is simply there before the agent is.
#
# The .NET variables ride on the entry for the same reason, and it is not
# belt-and-braces: `distrobox enter <ctx> -- claude` runs the command with no
# shell at all, so nothing in the container's .bashrc is ever read. Measured --
# on that path even PATH is the host's, /home/stsiapan/... and not
# .../homes/<ctx>/... . An agent started by the `-claude` or `-tmux` alias
# therefore built with Server GC no matter what the container's rc said, which
# is exactly the case that mattered, since builds here are run by agents and
# not typed into a shell. Host env does cross the boundary (verified with a
# probe variable), so setting it here reaches every session; the copy in the
# container's rc below stays for shells entered some other way.
#
# The two session flags of the tmux twin are NOT the same kind of thing as
# herdr's. tmux keeps its server socket in /tmp, which distrobox shares with
# every container, so `-L <name>` is what stops three contexts from sharing one
# server -- it must not be dropped. Neither socket is a boundary, though: the
# host home is bind-mounted into every container, so one context can read
# another's home and connect to whatever socket it finds there. The netns is
# the boundary; the multiplexer socket is not.
{{- range .contexts }}
alias {{ .name }}='{{ if $herdr }}HERDR_AGENT=claude {{ end }}{{ $dotnetenv }}distrobox enter --no-workdir {{ .name }}'
{{- if $herdr }}
alias {{ .name }}-claude='HERDR_AGENT=claude {{ $dotnetenv }}distrobox enter --no-workdir {{ .name }} -- claude'
{{- end }}
{{- if $tmux }}
alias {{ .name }}-tmux='{{ $dotnetenv }}distrobox enter --no-workdir {{ .name }} -- tmux -L {{ .name }} new-session -A -s work'
{{- end }}
{{- end }}
{{- if or (has "claude" .enabled) (has "codex" .enabled) }}

# Agent sessions started on the host go under user-agents.slice -- a child of
# the user manager's user.slice, where rootless podman already parents every
# container, so the single budget in
# ~/.config/systemd/user/user.slice.d/50-agents-budget.conf covers agent work
# wherever it runs. Sessions inside containers need no wrapper: their cgroup
# is the container's, already under the umbrella. No recursion here --
# systemd-run execs the PATH binary, shell functions do not survive into the
# new scope.
{{- if has "claude" .enabled }}
claude() { slice-run user-agents.slice claude "$@"; }
{{- end }}
{{- if has "codex" .enabled }}
codex() { slice-run user-agents.slice codex "$@"; }
{{- end }}
{{- end }}
{{ end }}
{{ if and (eq .env "container") (has "nested-podman" .enabled) }}
# Containers run INSIDE this context (nested rootless podman, see
# docs/nested-podman.md). DOCKER_HOST points every docker-speaking tool
# (docker CLI, Aspire's DCP, Testcontainers) at the box-local API socket.
# DOCKER_BUILDKIT=0 keeps `docker build` on the legacy builder: podman's
# compat API does not speak BuildKit, and modern docker CLI defaults to it.
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
export DOCKER_BUILDKIT=0
{{ end }}
{{ if and (eq .env "container") (has "dotnet" .enabled) }}
# Every .NET process reads the cgroup limit and sizes itself as if it owned the
# box. Server GC opens one heap per core -- 12 here -- so six long-running
# services under Aspire each reserve twelve heaps inside one --memory=8g lid.
# That is what filled the cap on 2026-08-24 and livelocked the container in
# reclaim for fifteen minutes without a single OOM kill; the investigation is
# docs/issues/2026-08-24-container-livelock-at-memory-cap.md. Workstation GC is
# one heap per process and costs throughput no local dev run will notice.
# Verified present in SDK 10.0.110: `strings -el libcoreclr.so | grep -x gcServer`.
#
# This is the fallback path. The primary one is the `<ctx>` aliases above, which
# carry the same three variables across the boundary, because `distrobox enter
# <ctx> -- <cmd>` reads no rc file at all. What is left for this block is a
# shell entered some other way, and it is guarded non-interactive-first by the
# `[[ $- != *i* ]] && return` on line 1, so it reaches interactive shells only.
export DOTNET_gcServer=0

# 0-9, trades CPU for a smaller heap and returns pages to the OS sooner. Set
# because memory, not CPU, is the binding constraint in a container. Drop it
# first if a build ever feels slow -- it is a tuning knob, not a correctness one.
export DOTNET_GCConserveMemory=5

# `dotnet build` passes -maxCpuCount implicitly, so a build forks one MSBuild
# node per core; with reuse they then idle for another 15 minutes holding their
# heaps, which is how two builds left 22 nodes resident. Nodes now exit with the
# build. Verified present in SDK 10.0.110 Microsoft.Build.dll (UTF-16 strings).
# This caps lifetime, not count: to cap count too, pass `-m:4` per build.
export MSBUILDDISABLENODEREUSE=1
{{ end }}
{{ if has "dotnet" .enabled }}
# `dotnet dev-certs https --trust` exports the ASP.NET dev certificate into
# this directory, but OpenSSL-based clients -- .NET itself included on Linux --
# only consult it when SSL_CERT_DIR says so (the dev-certs tool prints exactly
# this instruction). Without it the Aspire dashboard rejects its own resource
# service with UntrustedRoot. Inert until the export exists.
if [ -d "$HOME/.aspnet/dev-certs/trust" ]; then
    export SSL_CERT_DIR="$HOME/.aspnet/dev-certs/trust:${SSL_CERT_DIR:-/etc/ssl/certs}"
fi
{{ end }}
# --- modern shell tooling ---------------------------------------------------
# The same file is deployed into the host and into every container, so it runs
# in several environments. Each line is guarded with `command -v` so a missing
# binary in one environment never breaks the shell in another.
command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash)"   # adds: z <dir> / zi
command -v fzf      >/dev/null && eval "$(fzf --bash)"         # Ctrl-R hist / Ctrl-T files / Alt-C cd

if command -v eza >/dev/null; then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -l  --group-directories-first --icons=auto --git'
    alias la='eza -la --group-directories-first --icons=auto --git'
    alias lt='eza --tree --level=2 --icons=auto'
fi

if command -v bat >/dev/null; then
    export BAT_THEME="Nord"
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    # To make cat use bat, uncomment: alias cat='bat --plain --paging=never'
fi

# fzf: Nord colours + sensible defaults
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border=rounded --info=inline --color=bg+:#3b4252,bg:#2e3440,spinner:#81a1c1,hl:#616e88,fg:#d8dee9,header:#616e88,info:#81a1c1,pointer:#81a1c1,marker:#a3be8c,fg+:#d8dee9,prompt:#81a1c1,hl+:#81a1c1"
